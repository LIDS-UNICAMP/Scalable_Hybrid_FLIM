+# growth v3.1: vistas ASSIMÉTRICAS do BYOL/Barlow (T: blur 1,0 / solarize 0; T': blur 0,1 / solarize 0,2), em LAB
+ASYM_VIEWS = ({"crop_scale": (0.08, 1.0), "hflip_p": 0.5, "vflip_p": 0.0, "brightness": 0.4, "contrast": 0.4,
