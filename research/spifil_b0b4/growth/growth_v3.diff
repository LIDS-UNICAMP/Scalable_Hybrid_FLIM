+def _make_expander(d: int, dims: Sequence[int] = (2048, 2048, 2048)) -> nn.Module:
+    """growth_v3: expander do VICReg (paper: 3 camadas, Linear-BN-ReLU-Linear-BN-ReLU-Linear)."""
+    dims = [int(x) for x in dims]
+    layers: List[nn.Module] = []
