+    ra = train_global_ssl(a_enc, a_head, _loader(), "lejepa", "sigreg", 1, 1e-3, 1e-3, [], "cpu", seed=2)
+    rb = train_global_ssl(b_enc, b_head, _loader(), "lejepa", "sigreg", 1, 1e-3, 1e-3, [], "cpu", seed=2,
+                          freeze_head=False)
