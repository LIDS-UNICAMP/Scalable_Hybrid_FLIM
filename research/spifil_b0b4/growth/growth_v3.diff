+def aug_record(cfg: Any) -> Dict[str, Any]:
+    """Registro json-safe da DA efetiva (tuplas -> listas)."""
+    import dataclasses
+    d = dataclasses.asdict(aug_config(cfg))
+    return {k: (list(v) if isinstance(v, tuple) else v) for k, v in d.items()}
