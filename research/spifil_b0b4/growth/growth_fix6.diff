+        ssl_log = train_global_ssl(enc, model.head, ev.train_loader, gcfg.get("ssl", "lejepa"), gcfg.get("reg", "sigreg"),
+                                   epochs, lr, lr, [], dev, _NullRun(), int(seed), float(tr.get("sigreg_lambda", 0.05)),
+                                   max_steps_per_epoch=tr.get("max_steps_per_epoch"), conv_lr_scale=1.0,
+                                   projector=False, **amp_kw, **extra)
+    del enc
+    return ssl_log
