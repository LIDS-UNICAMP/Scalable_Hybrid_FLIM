+    with pytest.raises(BK.BandError):
+        BK.stratified_block({"param_cap": 5_775_000})                      # o x1,05 do PNAS-CS
+    bad = S.strat_config({"strata": {"B0": [0, 300000], "B1": [300000, 5500000]}, "param_cap": 5_500_000})
+    with pytest.raises(BK.BandError):
