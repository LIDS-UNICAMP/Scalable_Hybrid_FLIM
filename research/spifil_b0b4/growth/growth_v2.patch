new file mode 100644
index 0000000..195f4f7
--- /dev/null
+++ b/tests/backbones/_bb_helpers.py
@@ -0,0 +1,80 @@
+"""Utilidades dos testes de ga_search/backbones (CPU, fp32, determinístico)."""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+from ga_search.backbones.build import Backbone, build_backbone
+from ga_search.backbones.spec import BackboneSpec, HeadSpec, InputSpec, LayerSpec, StageSpec
+from ga_search.modehb.ops_norm_act import DecorrelatedBatchNorm, ZCAWhitening
+
+TOL = 1e-5
+
+
+def small_spec(layers, *, head=None, stem=8, stem_act="relu", stem_norm="none", res=32) -> BackboneSpec:
+    """stem conv k3 (pool max) + um estágio 'local' com ``layers`` (LayerSpec)."""
+    return BackboneSpec(stem=LayerSpec(channels=stem, kernel=3, pool="max", activation=stem_act, norm=stem_norm),
+                        stages=[StageSpec(name="local", layers=list(layers))],
+                        head=head or HeadSpec(embed_dim=1280, pooling="gem"),
+                        input=InputSpec(resolution=res)).normalize()
+
+
+def randomize_stats(model: nn.Module, seed: int = 0, x: torch.Tensor | None = None) -> nn.Module:
+    """Torna BN/ZCA/DBN não triviais: BN com stats/afim aleatórios; ZCA ajustado em ativações reais
+    (pré-hook); DBN com running_W atualizado em 5 passos de treino; bias e GatedSkip aleatórios."""
+    g = torch.Generator().manual_seed(seed)
+    with torch.no_grad():
+        for m in model.modules():
+            if isinstance(m, (nn.BatchNorm2d,)):
+                m.running_mean.copy_(torch.randn(m.num_features, generator=g) * 0.1)
+                m.running_var.copy_(torch.rand(m.num_features, generator=g) + 0.5)
+                m.weight.copy_(torch.randn(m.num_features, generator=g) * 0.5 + 1)
+                m.bias.copy_(torch.randn(m.num_features, generator=g) * 0.1)
+            if isinstance(m, nn.Conv2d) and m.bias is not None:
+                m.bias.copy_(torch.randn(m.bias.shape, generator=g) * 0.05)
+    if x is not None:
+        hooks = []
+
+        def fit_hook(mod, inp):
+            if not bool(mod.fitted):
+                mod.fit(inp[0])
+        for m in model.modules():
+            if isinstance(m, ZCAWhitening):
+                hooks.append(m.register_forward_pre_hook(fit_hook))
+        dbn = any(isinstance(m, DecorrelatedBatchNorm) for m in model.modules())
+        was = model.training
+        model.train(dbn)
+        bns = [m for m in model.modules() if isinstance(m, nn.BatchNorm2d)]
+        saved = [(m.running_mean.clone(), m.running_var.clone()) for m in bns]
+        with torch.no_grad():
+            for _ in range(5 if dbn else 1):
+                model(x)
+        with torch.no_grad():
+            for m, (rm, rv) in zip(bns, saved):
+                m.running_mean.copy_(rm)
+                m.running_var.copy_(rv)
+        for h in hooks:
+            h.remove()
+        model.train(was)
+    return model
+
+
+def make_parent(spec: BackboneSpec, seed: int = 0, x: torch.Tensor | None = None) -> Backbone:
+    m = build_backbone(spec, seed=seed, enforce_budget=False)
+    randomize_stats(m, seed, x)
+    return m.eval()
+
+
+def assert_exact(g, tol: float = TOL):
+    p = g.preservation
+    assert p.exact_claimed, g.operations
+    assert p.verdict == "exact", (p.verdict, p.per_layer, p.emb_rel_l2)
+    assert p.map_rel_l2 is not None and p.map_rel_l2 <= tol, p.map_rel_l2
+    assert p.emb_rel_l2 is not None and p.emb_rel_l2 <= tol, p.emb_rel_l2
+    assert p.emb_cos_min >= 1 - 1e-6
+    for r in p.per_layer:
+        assert r["rel_l2"] <= tol, r
+
+
+def x_batch(n=4, res=32, seed=123):
+    return torch.rand(n, 3, res, res, generator=torch.Generator().manual_seed(seed))
