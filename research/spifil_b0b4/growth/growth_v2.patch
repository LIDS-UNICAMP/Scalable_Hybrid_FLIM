+        x[i, 0] = torch.exp(-((yy - r) ** 2 + (xx - c) ** 2) / (2 * 1.5 ** 2))
+    pol = s2.AugPolicy(crop_scale=(0.5, 0.9), brightness=0, contrast=0, channel_jitter=0, rot90=rot)
+    views, thetas, _ = s2.make_views_with_theta(x, 2, pol, seed=1)
+    fa = F.avg_pool2d(views[0], pool) if pool > 1 else views[0]
+    fb = F.avg_pool2d(views[1], pool) if pool > 1 else views[1]
+    G = fa.shape[-1]
+    corr = s2.correspondences(thetas[0], thetas[1], (G, G))
+    errs = []
+    for i in range(n):
+        if fa[i].max() < 0.2 or fb[i].max() < 0.2:
+            continue
+        ra, ca = _centroid(fa[i, 0])
+        rb, cb = _centroid(fb[i, 0])
+        pa = int(round(ra)) * G + int(round(ca))
+        sel = (corr.img == i) & (corr.pa == pa)
+        if not bool(sel.any()):
+            continue
+        ib, jb = int(corr.ib[sel][0]), int(corr.jb[sel][0])
+        errs.append(max(abs(ib - rb), abs(jb - cb)))
+    assert len(errs) >= n // 2
+    assert max(errs) <= 1.0 + 1e-6, errs          # tolerância de 1 célula (desenho §5.2)
+    assert sum(errs) / len(errs) <= 0.75, errs
+
+
+def test_sinkhorn_equipartition():
+    s = torch.randn(400, 10, generator=torch.Generator().manual_seed(0))
+    q = s2.sinkhorn(s, eps=0.5, iters=200)
+    assert torch.allclose(q.sum(1), torch.ones(400), atol=1e-5)
+    assert torch.allclose(q.sum(0), torch.full((10,), 40.0), rtol=1e-2)
+
+
+def test_registries():
+    assert "aug_default" in s2.AUG_POLICIES and "flowers" in s2.AUG_POLICIES
+    assert s2.AUG_POLICIES["flowers"].vflip_p == 0.0 and s2.AUG_POLICIES["flowers"].channel_jitter == 0.0
+    assert {"s2", "s2_noinv", "s2_sup", "s2_ref_vicregl", "s2_ref_swav"} <= set(s2.VARIANTS)
+    with pytest.raises(ValueError):
+        s2.make_views_with_theta(torch.zeros(1, 3, 8, 8), 1, "nao_existe", seed=0)
+    k = torch.ones(1, 3 * 9)
+    assert float(s2.dc_fraction(k, 3)) == pytest.approx(1.0)
