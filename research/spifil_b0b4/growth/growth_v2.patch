@@ -0,0 +1,140 @@
+"""Contagem de params (encoder + cabeça; extras à parte), MACs/FLOPs (FLOPs = 2 x MACs), teto duro e reparo."""
+import pytest
+import torch
+
+from _bb_helpers import small_spec
+from ga_search.backbones.budget import head_candidates, repair_head
+from ga_search.backbones.build import BudgetError, build_backbone, param_count_spec
+from ga_search.backbones.family import REF_FLAT, flat_spec, reference_family_specs
+from ga_search.backbones.spec import BUDGETS, HARD_CAP, HeadSpec, LayerSpec
+
+
+def conv_p(cin, cout, k, bias=True, groups=1):
+    return cout * (cin // groups) * k * k + (cout if bias else 0)
+
+
+def flat_analytic(widths, head_width, embed_bias=True, res=224):
+    """params e MACs da família plana, calculados à mão (independente do código)."""
+    chans = [widths["stem"]] + [w for n in ("local", "intermediate", "abstract") for w in widths[n]]
+    ks = [5] + [3] * (len(chans) - 1)
+    pools = [True] + [i == len(widths[n]) - 1 for n in ("local", "intermediate", "abstract")
+                      for i in range(len(widths[n]))]
+    cin, p, macs, r = 3, 0, 0, res
+    for c, k, pl in zip(chans, ks, pools):
+        p += conv_p(cin, c, k)
+        macs += r * r * c * cin * k * k
+        cin = c
+        if pl:
+            r //= 2
+    head_p = cin * head_width + (head_width if embed_bias else 0)
+    head_macs = r * r * cin * head_width
+    return p, head_p, macs, head_macs
+
+
+@pytest.mark.parametrize("k", list(REF_FLAT))
+@pytest.mark.parametrize("pooling,width", [("gem", 1280), ("meanstd", 640), ("moments", 320)])
+def test_params_and_flops_reference(k, pooling, width):
+    spec = flat_spec(REF_FLAT[k], head=HeadSpec(pooling=pooling))
+    m = build_backbone(spec, enforce_budget=False)
+    pe, ph, me, mh = flat_analytic(REF_FLAT[k], width)
+    c = m.spec.cost
+    assert (c.params_encoder, c.params_head, c.params_total) == (pe, ph, pe + ph)
+    assert (c.macs_encoder, c.macs_head, c.macs) == (me, mh, me + mh)
+    assert c.flops == 2 * c.macs and "2 * macs" in c.flops_definition
+    assert param_count_spec(spec) == (pe, ph)
+
+
+def test_design_table_numbers():
+    """Tabela §4 do desenho (GeM 1280): totais 0,272/0,882/1,494/2,945/5,231M e GMACs 0,42/1,31/2,27/4,61/7,69."""
+    exp = {"B0": (272272, 0.42), "B1": (881664, 1.31), "B2": (1493504, 2.27), "B3": (2944576, 4.61),
+           "B4": (5230624, 7.69)}
+    for k, (tot, gm) in exp.items():
+        c = build_backbone(flat_spec(REF_FLAT[k]), enforce_budget=False).spec.cost
+        assert c.params_total == tot
+        assert abs(c.macs / 1e9 - gm) < 0.01
+
+
+def test_cost_other_operators_and_extras():
+    L = LayerSpec
+    spec = small_spec([L(8, conv="dwsep", norm="batch"), L(12, conv="inception"), L(12, residual="project"),
+                       L(12, residual="gated", pool="max")], head=HeadSpec(pooling="moments", proj="lowrank", rank=16),
+                      res=32)
+    spec.extras_not_counted = {"ae_decoder": 10_000, "ssl_projector": 5_000}
+    m = build_backbone(spec, enforce_budget=False)
+    enc = (conv_p(3, 8, 3) + (8 * 9 + conv_p(8, 8, 1, bias=False) + 2 * 8)          # stem; dwsep (dw sem bias) + BN
+           + conv_p(8, 3, 1) + conv_p(8, 3, 3) + conv_p(8, 3, 5) + conv_p(8, 3, 1)   # inception 3/3/3/3
+           + conv_p(12, 12, 3) + 12 * 12                                   # conv + skip project 1x1 sem bias
+           + conv_p(12, 12, 3) + 1)                                        # conv + gate
+    head = 12 * 16 + conv_p(16, 320, 1)
+    c = m.spec.cost
+    assert (c.params_encoder, c.params_head) == (enc, head)
+    assert c.params_total == enc + head and c.params_extras == {"ae_decoder": 10_000, "ssl_projector": 5_000}
+    macs = (32 * 32 * 8 * 27) // 1 + 0
+    r = 16
+    macs += r * r * 8 * 9 + r * r * 8 * 8                                   # dwsep
+    macs += r * r * 3 * 8 * (1 + 9 + 25 + 1)                                # inception
+    macs += r * r * 12 * 12 * 9 + r * r * 12 * 12                           # conv + project
+    macs += r * r * 12 * 12 * 9                                             # gated conv
+    r = 8
+    macs_head = r * r * 12 * 16 + r * r * 16 * 320
+    assert c.macs == macs + macs_head and c.macs_head == macs_head and c.flops == 2 * c.macs
+
+
+def test_meta_and_real_mac_count_agree():
+    spec = small_spec([LayerSpec(12, norm="zca"), LayerSpec(16, pool="max")])     # ZCA força a contagem real
+    spec2 = small_spec([LayerSpec(12, norm="batch"), LayerSpec(16, pool="max")])  # meta
+    a, b = build_backbone(spec, enforce_budget=False), build_backbone(spec2, enforce_budget=False)
+    assert a.spec.cost.macs == b.spec.cost.macs
+
+
+def test_hard_cap_and_class_cap():
+    big = flat_spec({"stem": 64, "local": [128, 128], "intermediate": [256, 256, 256], "abstract": [512, 512]})
+    e, h = param_count_spec(big)
+    assert e + h > HARD_CAP
+    with pytest.raises(BudgetError):
+        build_backbone(big, enforce_budget=False)          # teto duro vale sempre
+    b1 = flat_spec(REF_FLAT["B1"], budget_class="B1")       # GeM: 881.664 > 800k
+    with pytest.raises(BudgetError):
+        build_backbone(b1)
+
+
+def test_head_repair_keeps_dim_and_changes_hash():
+    b1 = flat_spec(REF_FLAT["B1"], budget_class="B1")
+    fixed, log = repair_head(b1, "B1")
+    assert log["repaired"] and log["to_head"] == "meanstd1280" and fixed.head.embed_dim == 1280
+    assert fixed.hash12 != b1.hash12 and b1.head.pooling == "gem"   # entrada intacta
+    m = build_backbone(fixed)
+    assert m.spec.cost.params_total <= BUDGETS["B1"] and m(torch.rand(1, 3, 64, 64)).shape == (1, 1280)
+    # encoder grande: só lowrank cabe
+    tight = flat_spec({"stem": 32, "local": [64], "intermediate": [128, 128], "abstract": [300, 300]},
+                      head=HeadSpec(pooling="gem", embed_dim=1536), budget_class="B2")
+    fixed2, log2 = repair_head(tight, "B2")
+    assert fixed2.head.proj == "lowrank" and fixed2.head.embed_dim == 1536
+    m2 = build_backbone(fixed2)
+    assert m2(torch.rand(1, 3, 64, 64)).shape == (1, 1536)
+    # nada cabe -> erro (o reparo nunca reduz a dimensão)
+    with pytest.raises(BudgetError):
+        repair_head(flat_spec(REF_FLAT["B4"]), "B0")
+    assert all(h.embed_dim == 1280 for h in head_candidates(HeadSpec()))
+
+
+def test_reference_family_in_bands():
+    specs, log = reference_family_specs()
+    assert log["from_head"] == "gem1280" and log["head"] == "meanstd1280" and log["repaired"]
+    lo = 0
+    for k, s in zip(REF_FLAT, specs):
+        m = build_backbone(s)
+        n = m.spec.cost.params_total
+        assert lo < n <= BUDGETS[k] <= HARD_CAP and m.spec.budget_class == k
+        assert m.spec.head.embed_dim >= 1280
+        lo = BUDGETS[k]
+
+
+def test_growth_beyond_hard_cap_refused():
+    """Um morfismo que leva o filho acima de 5,5M é recusado no finalize (nunca há filho > teto)."""
+    from ga_search.backbones.morphisms import finalize, start, widen
+    specs, _ = reference_family_specs()
+    b4 = build_backbone(specs[-1])
+    res = widen(start(b4), {len(b4.blocks) - 1: 560})
+    with pytest.raises(BudgetError):
+        finalize(res)
