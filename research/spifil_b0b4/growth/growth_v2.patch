+    assert torch.equal(wr["conv.weight"], wr2["conv.weight"])  # classe registrada == config latent=random
+    assert pr["variant"] == "S3-rand" and pt["variant"] == "S3" and pr["method"] == "spifil3_rand"
+    assert pr["diagnostics"]["stage1"]["steps_run"] == 0
