+"""CPU tests: interface base (shapes/contrato) + adaptadores SPiFiL-0 (S0 bitwise, S0+, S0-data).
+
+SPiFiL REAL em PNGs sintéticos (mesmo fixture de tests/modehb/test_spifil_ops.py).
+"""
+import copy
+import math
+
+import numpy as np
+import pytest
+import torch
+from torch import nn
+
+from ga_search.abstract_init import base as B
+from ga_search.abstract_init import spifil0 as S0
+from ga_search.modehb import init as mi
+from ga_search.modehb import spifil_ops as so
+
+SIZE = 32
+CFG = {"device": "cpu", "image_size": SIZE, "n_superpixels": 30, "impurities": True, "spifil_ops": True}
+
+
+@pytest.fixture(scope="module")
+def samples(tmp_path_factory):
+    from skimage.io import imsave
+    from spifil.data import Sample
+    d = tmp_path_factory.mktemp("imgs")
+    rng = np.random.default_rng(0)
+    out = []
+    for i in range(12):
+        lab = i % 2 + 1
+        img = (rng.random((40, 40, 3)) * 255).astype(np.uint8)
+        if lab == 2:
+            img[:, :, 0] = np.linspace(0, 255, 40)[None].astype(np.uint8)
+        p = d / f"{lab:06d}_{i:08d}.png"
+        imsave(p, img, check_contrast=False)
+        out.append(Sample(p.stem, p, None, lab))
+    return out
+
+
+def _pool(samples):
+    pool = {}
+    for s in samples:
+        pool.setdefault(int(s.label), []).append(s)
+    return pool
+
+
+def _prefix(cout=4):
+    torch.manual_seed(0)
+    p = nn.Sequential(nn.Conv2d(3, cout, 3, padding=1), nn.Tanh()).eval()
+    p.out_channels = cout
+    return p
+
+
+def _layer(**kw):
+    base = dict(active=True, channels=8, kernel=3, conv="conv", residual=False,
+                activation="relu", norm="none", pool="none", softhebb=False)
+    base.update(kw)
+    return base
+
+
+def _genome(**kw):
+    return dict(init="spifil", seed=7, depth=1, layers=[_layer(**kw)] + [_layer()] * 7,
+                spifil_images_per_class=2)
+
+
+def _td(donors, pool=None, **kw):
+    return B.TrainData(donors=donors, donor_pool=pool or {}, split_key=kw.pop("split_key", "train"),
+                       split_fingerprint="t", n_classes=2, image_size=SIZE, **kw)
+
+
+def _ctx(genome, layer_idx=0, **kw):
+    return B.InitContext(seed=int(genome["seed"]) + layer_idx, device=torch.device("cpu"), layer_idx=layer_idx,
+                         prefix_id="p", spifil_config=dict(CFG), genome=genome, **kw)
+
+
+SPECS = [
+    _layer(), _layer(kernel=5, pool="max"), _layer(conv="pointwise", kernel=1), _layer(conv="dwsep"),
+    _layer(conv="inception", channels=16), _layer(conv="depthwise", channels=8), _layer(residual=True),
+    _layer(residual=True, channels=4), _layer(kernel=7, norm="batch"),
+]
+
+
+# ─── base: shapes / validação / montagem ─────────────────────────────────────
+
+@pytest.mark.parametrize("L", SPECS)
+def test_conv_param_keys_and_assemble_roundtrip(L):
+    spec = so.to_ops_spec(L, 4)
+    keys = B.conv_param_keys(spec)
+    ref = so.SpifilOpsBlock(spec, 4)
+    w, b = B.split_state(ref)
+    assert set(w) | set(b) == set(keys)
+    assert all(tuple(v.shape) == keys[k] for k, v in {**w, **b}.items())
+    blk = B.assemble_block(spec, w, b)
+    for k, v in {**w, **b}.items():
+        assert torch.equal(blk.state_dict()[k], v)
+    assert blk(torch.randn(1, 4, 16, 16)).shape[1] == int(spec["channels"])
+
+
+def test_validate_init_rejects_bad_inputs():
+    spec = so.to_ops_spec(_layer(), 4)
+    w, b = B.split_state(so.SpifilOpsBlock(spec, 4))
+    B.validate_init(spec, w, b)
+    with pytest.raises(ValueError, match="chaves"):
+        B.validate_init(spec, {}, b)
+    with pytest.raises(ValueError, match="shape"):
+        B.validate_init(spec, {"conv.weight": torch.zeros(8, 4, 5, 5)}, b)
+    with pytest.raises(ValueError, match="dtype"):
+        B.validate_init(spec, {"conv.weight": w["conv.weight"].double()}, b)
+    bad = w["conv.weight"].clone()
+    bad[0, 0, 0, 0] = float("nan")
+    with pytest.raises(ValueError, match="finitos"):
+        B.validate_init(spec, {"conv.weight": bad}, b)
+
+
+def test_train_only_and_registry():
+    with pytest.raises(ValueError):
+        B.check_train_only(_td([], split_key="validation"))
+    assert {"spifil0", "s0plus", "s0data"} <= set(B.available())
+    with pytest.raises(KeyError):
+        B.get_initializer("nao_existe")
+    assert isinstance(B.get_initializer("s0plus", knn_smooth=3), S0.Spifil0Plus)
+    assert B.get_initializer("s0plus", knn_smooth=3).config["knn_smooth"] == 3
+
+
+def test_infeasible_is_flim_class():
+    from flim.progressive import InfeasibleCandidate
+    assert B.InfeasibleCandidate is InfeasibleCandidate
+
+
+class _Toy(B.KernelInitializer):
+    """Inicializador mínimo: filtros = primeiras direções canônicas (determinístico, sem dados)."""
+    name, version = "toy", "0"
+
+    def fit(self, prefix, train_data, block_spec, context):
+        keys = B.conv_param_keys(block_spec)
+        g = torch.Generator().manual_seed(int(context.seed))
+        w = {k: torch.randn(s, generator=g) for k, s in keys.items() if not k.endswith("bias")}
+        b = {k: torch.zeros(s) for k, s in keys.items() if k.endswith("bias")}
+        prov = B.make_provenance("toy", "0", context=context, train_data=train_data, requested_spec=block_spec,
+                                 effective_spec=dict(block_spec), labels_used=False, label_source="none",
+                                 mask_used=False, n_images=0)
+        return w, b, prov
+
+
+@pytest.mark.parametrize("L", SPECS[:7])
+def test_init_block_contract_shapes_prefix_rng(L):
+    g = dict(_genome(), layers=[L] + [_layer()] * 7)
+    prefix = _prefix()
+    before = B.prefix_fingerprint(prefix)
+    torch.manual_seed(123)
+    blk, prov = _Toy().init_block(g, 0, prefix, _td([]), _ctx(g))
+    after_rng = torch.rand(1)
+    torch.manual_seed(123)
+    assert torch.equal(torch.rand(1), after_rng)            # montar não consome o RNG global
+    assert B.prefix_fingerprint(prefix) == before            # I1
+    x = prefix(torch.randn(2, 3, 16, 16))
+    assert blk(x).shape[1] == prov["effective_spec"]["channels"]
+    twin = so.random_twin_ops(prov["effective_spec"], 1, in_channels=4)   # gêmeo aleatório: mesma estrutura
+    assert list(twin.state_dict()) == list(blk.state_dict())
+    import json
+    json.dumps(prov, default=str)
+
+
+def test_init_block_detects_prefix_mutation():
+    class Bad(_Toy):
+        def fit(self, prefix, train_data, block_spec, context):
+            with torch.no_grad():
+                next(prefix.parameters()).add_(1.0)
+            return super().fit(prefix, train_data, block_spec, context)
+    g = _genome()
+    with pytest.raises(B.InfeasibleCandidate):
+        Bad().init_block(g, 0, _prefix(), _td([]), _ctx(g))
+
+
+# ─── S0: bit a bit igual a init.init_block ───────────────────────────────────
+
+@pytest.mark.parametrize("L", [_layer(), _layer(conv="dwsep", pool="max"), _layer(residual=True),
+                               _layer(conv="inception", channels=8)])
+@pytest.mark.parametrize("layer_idx", [0, 1])
+def test_s0_bitwise_equal_to_production(samples, L, layer_idx):
+    g = dict(_genome(), layers=[L, L] + [_layer()] * 6, depth=2)
+    prefix = _prefix() if layer_idx else None
+    donors = samples[:8]
+    torch.manual_seed(5)
+    ref, rprov = mi.init_block(copy.deepcopy(g), layer_idx, prefix, donors, dict(CFG), "p")
+    r_after = torch.rand(3)
+    torch.manual_seed(5)
+    blk, prov = B.get_initializer("spifil0").init_block(copy.deepcopy(g), layer_idx, prefix, _td(donors),
+                                                         _ctx(g, layer_idx))
+    a_after = torch.rand(3)
+    assert type(blk) is type(ref)
+    sr, sa = ref.state_dict(), blk.state_dict()
+    assert list(sr) == list(sa)
+    assert all(torch.equal(sr[k], sa[k]) for k in sr)
+    assert torch.equal(r_after, a_after)                     # mesmo estado do RNG global depois
+    assert prov["effective_spec"] == rprov["effective_spec"]
+    assert prov["method"] == "spifil0" and prov["labels_used"] is True
+
+
+def test_s0_fit_path_matches_init_block(samples):
+    g = _genome()
+    donors = samples[:4]
+    blk, _ = B.get_initializer("spifil0").init_block(g, 0, None, _td(donors), _ctx(g))
+    w, b, prov = B.get_initializer("spifil0").fit(None, _td(donors), so.to_ops_spec(_layer(), 3), _ctx(g))
+    for k, v in {**w, **b}.items():
+        assert torch.equal(blk.state_dict()[k].cpu(), v)
+    B.validate_init(prov["effective_spec"], w, b)
+
+
+def test_s0_deterministic(samples):
+    g = _genome()
+    a, _ = B.get_initializer("spifil0").init_block(g, 0, None, _td(samples[:4]), _ctx(g))
+    b, _ = B.get_initializer("spifil0").init_block(g, 0, None, _td(samples[:4]), _ctx(g))
+    assert all(torch.equal(a.state_dict()[k], b.state_dict()[k]) for k in a.state_dict())
+
+
+# ─── S0+ ─────────────────────────────────────────────────────────────────────
+
+def test_s0plus_whiten_folds_and_restores(samples):
+    import flim.progressive as FP
+    import flim.spifil as FS
+    g = _genome()
+    orig_s, orig_p = FS.GrowOneLayer, FP.GrowOneLayer
+    donors = samples[:6]
+    plus, prov = B.get_initializer("s0plus", whiten=True, select_diverse=0.0).init_block(
+        g, 1, _prefix(), _td(donors), _ctx(g, 1))
+    assert FS.GrowOneLayer is orig_s and FP.GrowOneLayer is orig_p          # restaurado
+    base_blk, _ = B.get_initializer("spifil0").init_block(g, 1, _prefix(), _td(donors), _ctx(g, 1))
+    assert prov["s0plus_record"]["zca_folded"] >= 1
+    assert not torch.equal(plus.conv.weight, base_blk.conv.weight)
+    assert torch.isfinite(plus.conv.weight).all()
+    assert any("zca_folded" in a for a in prov["abstract_init"]["approximations"])
+
+
+def test_s0plus_fold_is_exact_against_whitened_space():
+    """A dobra w <- W f reproduz <f, W x> no espaço original (mesma identidade usada por flim.spifil.grow)."""
+    torch.manual_seed(0)
+    x = torch.randn(500, 12, dtype=torch.float64)
+    s, u = torch.linalg.eigh(torch.cov(x.T))
+    zca = u @ torch.diag(1 / torch.sqrt(s + 1e-2 * s.mean())) @ u.T
+    f = torch.randn(5, 12, dtype=torch.float64)
+    assert torch.allclose((x @ zca) @ f.T, x @ (f @ zca).T, atol=1e-10)
+
+
+def test_s0plus_options_change_with_knn(samples):
+    g = _genome()
+    a, _ = B.get_initializer("s0plus", whiten=False, select_diverse=0.0, knn_smooth=0).init_block(
+        g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    b, _ = B.get_initializer("spifil0").init_block(g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    assert all(torch.equal(a.state_dict()[k], b.state_dict()[k]) for k in a.state_dict())   # tudo desligado == S0
+    c, _ = B.get_initializer("s0plus", whiten=False, select_diverse=0.0, knn_smooth=3).init_block(
+        g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    assert not torch.equal(c.conv.weight, b.conv.weight)
+
+
+# ─── S0-data ─────────────────────────────────────────────────────────────────
+
+def test_s0data_ipc_and_donor_check(samples):
+    from ga_search.modehb.run_search import spifil_subset
+    s = B.get_initializer("s0data", images_total=8)
+    assert s.ipc_for(2) == 4 and s.ipc_for(3) == 3 and s.ipc_for(2, pool_max=3) == 3
+    assert B.get_initializer("s0data", ipc=5).ipc_for(14) == 5
+    g = _genome()
+    g.update(s.genome_overrides(g, 2, 6))
+    assert g["spifil_images_per_class"] == 4
+    pool = _pool(samples)
+    donors = spifil_subset(pool, 4)
+    blk, prov = s.init_block(g, 0, None, _td(donors, pool), _ctx(g))
+    assert prov["data"]["n_images"] == 8 and prov["method"] == "s0data"
+    with pytest.raises(ValueError, match="primeiros"):
+        s.init_block(g, 0, None, _td(list(reversed(donors)), pool), _ctx(g))
+
+
+def test_s0data_never_shrinks_genome_ipc():
+    s = B.get_initializer("s0data", images_total=4)
+    assert s.genome_overrides({"spifil_images_per_class": 16}, 2, 32) == {"spifil_images_per_class": 16}
+
+
+# ─── label-free: invariância a permutação de rótulos (contrato I6, via um método label-free) ─────
+
+def test_label_free_dispatch_hides_labels():
+    """O despachante do runner entrega y = -1 a um método label-free (ele nunca vê rótulos)."""
+    from ga_search.abstract_init.run_ablation import _Dispatch
+
+    class LF(_Toy):
+        label_policy = "label_free"
+
+    class FakeEv:
+        svm_train_x = torch.randn(10, 3, 8, 8)
+        svm_train_y = torch.arange(10) % 2
+        split_hash = "h"
+        seed = 42
+        spifil_pool = {1: [], 2: []}
+        cfg = {"data": {"batch_size": 4, "image_size": 8}}
+        device = torch.device("cpu")
+    td = _Dispatch(FakeEv(), LF()).train_data([])
+    assert td.label_policy == "label_free" and td.mask_policy == "no_mask"
+    ys = torch.cat([y for _, y in td.loader_factory(0)])
+    assert (ys == -1).all()
+    xs1 = torch.cat([x for x, _ in td.loader_factory(0)])
+    FakeEv.svm_train_y = FakeEv.svm_train_y[torch.randperm(10)]       # rótulos permutados: mesmos x
+    xs2 = torch.cat([x for x, _ in _Dispatch(FakeEv(), LF()).train_data([]).loader_factory(0)])
+    assert torch.equal(xs1, xs2)
+    sup = _Dispatch(FakeEv(), _Toy()).train_data([])
+    assert sup.label_policy == "supervised"
+    assert sorted(torch.cat([y for _, y in sup.loader_factory(0)]).tolist()) == sorted(FakeEv.svm_train_y.tolist())
+
+
+def test_spifil1_label_free_permutation_invariant_via_interface():
+    """SPiFiL-1 (Agente 2b) pela interface: pesos idênticos com rótulos permutados (I6)."""
+    pytest.importorskip("ga_search.abstract_init.spifil1")
+    torch.manual_seed(0)
+    X = torch.rand(24, 3, 16, 16)
+    Y = torch.arange(24) % 3
+
+    def td(y):
+        def lf(seed):
+            g = torch.Generator().manual_seed(seed)
+            p = torch.randperm(24, generator=g)
+            for i in range(0, 24, 8):
+                yield X[p[i:i + 8]], y[p[i:i + 8]]
+        return B.TrainData(loader_factory=lf, split_key="train", n_classes=3, image_size=16, n_images=24,
+                           label_policy="label_free", mask_policy="no_mask")
+    spec = so.to_ops_spec(_layer(channels=6), 3)
+    m = B.get_initializer("spifil1")
+    ctx = B.InitContext(seed=3, budget=B.InitBudget(max_images=24, max_patches=2000))
+    w1, b1, p1 = m.fit(None, td(Y), spec, ctx)
+    w2, b2, p2 = m.fit(None, td(Y[torch.randperm(24)]), spec, ctx)
+    assert all(torch.equal(w1[k], w2[k]) for k in w1) and all(torch.equal(b1[k], b2[k]) for k in b1)
+    assert p1["labels_used"] is False
