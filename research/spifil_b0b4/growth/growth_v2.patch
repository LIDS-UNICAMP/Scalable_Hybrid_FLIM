+"""Testes CPU do SPiFiL-3 (ga_search/abstract_init/spifil3.py), dados sintéticos, < 1 min."""
+import gc
+import json
+
+import pytest
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from ga_search.abstract_init import base
+from ga_search.abstract_init import spifil3 as s3
+from ga_search.abstract_init.base import InfeasibleCandidate, InitBudget, InitContext, TrainData
+from ga_search.abstract_init.spifil3 import Spifil3Predictive, Spifil3Rand, build_block
+
+FAST = {"steps": 25, "latent_dim": 16, "batch_size": 8, "positions_per_image": 96,
+        "kmeans_iters": 10, "chunk": 8}
+
+
+def _images(n=24, size=24, seed=0, constant=False):
+    """3 'classes' com estrutura: listras horizontais, verticais e bolhas, + ruído."""
+    g = torch.Generator().manual_seed(seed)
+    if constant:
+        return torch.full((n, 3, size, size), 0.5), torch.zeros(n, dtype=torch.long)
+    yy, xx = torch.meshgrid(torch.arange(size).float(), torch.arange(size).float(), indexing="ij")
+    xs, ys = [], []
+    for i in range(n):
+        c = i % 3
+        ph = float(torch.rand((), generator=g)) * 6.28
+        if c == 0:
+            base = torch.sin(yy * 0.9 + ph)
+        elif c == 1:
+            base = torch.sin(xx * 0.9 + ph)
+        else:
+            cy, cx = (torch.rand(2, generator=g) * size).tolist()
+            base = torch.exp(-((yy - cy) ** 2 + (xx - cx) ** 2) / 18.0) * 2 - 0.5
+        img = torch.stack([base, 0.5 * base.roll(1, 0), -base]) * 0.25 + 0.5
+        img = img + 0.03 * torch.randn(3, size, size, generator=g)
+        xs.append(img.clamp(0, 1))
+        ys.append(c)
+    return torch.stack(xs), torch.tensor(ys)
+
+
+def _train_data(x, y, split_key="train", bs=8):
+    def factory(seed):
+        perm = torch.randperm(x.shape[0], generator=torch.Generator().manual_seed(seed))
+        for i in range(0, len(perm), bs):
+            yield x[perm[i:i + bs]], y[perm[i:i + bs]]
+    return TrainData(loader_factory=factory, split_key=split_key, split_fingerprint="synthetic",
+                     n_classes=3, image_size=x.shape[-1], n_images=x.shape[0], label_policy="label_free",
+                     mask_policy="no_mask")
+
+
+def _ctx(seed=11, diag_batch=None, **cfg):
+    return InitContext(seed=seed, device=torch.device("cpu"), layer_idx=1, prefix_id="synthetic-prefix",
+                       budget=InitBudget(max_images=24, max_patches=4000, max_seconds=120.0),
+                       config={**FAST, **cfg}, diag_batch=diag_batch)
+
+
+def _prefix(c_out=6):
+    torch.manual_seed(123)
+    p = nn.Sequential(nn.Conv2d(3, c_out, 3, padding=1), nn.ReLU())
+    p.train()  # o fit deve congelar (eval) e restaurar o estado depois
+    return p
+
+
+def _spec(conv="conv", k=3, cin=6, cout=8, residual=False, skip=None):
+    return {"builder": "spifil_ops", "norm_in_block": True, "conv": conv, "kernel": 1 if conv == "pointwise" else k,
+            "in_channels": cin, "channels": cout, "requested_channels": cout, "dw_multiplier": None,
+            "activation": "relu", "norm": "none", "pool": "none", "pool_stride": 1, "residual": residual,
+            "skip": skip, "dropout": 0.0}
+
+
+@pytest.fixture(scope="module")
+def data():
+    x, y = _images()
+    return x, y, _train_data(x, y)
+
+
+# ---------------------------------------------------------------- shapes
+
+
+@pytest.mark.parametrize("conv,k,cout,residual,skip", [
+    ("conv", 3, 8, False, None), ("conv", 5, 8, False, None), ("conv", 1, 8, False, None),
+    ("pointwise", 1, 8, False, None), ("conv", 3, 6, True, "identity"), ("conv", 3, 10, True, "project"),
+])
+def test_shapes_and_assembly(data, conv, k, cout, residual, skip):
+    x, _, td = data
+    prefix = _prefix()
+    spec = _spec(conv, k, cout=cout, residual=residual, skip=skip)
+    w, b, prov = Spifil3Predictive().fit(prefix, td, spec, _ctx())
+    kk = 1 if conv == "pointwise" else k
+    assert tuple(w["conv.weight"].shape) == (cout, 6, kk, kk)
+    assert tuple(b["conv.bias"].shape) == (cout,)
+    if skip == "project":
+        assert tuple(w["skip.weight"].shape) == (cout, 6, 1, 1) and tuple(b["skip.bias"].shape) == (cout,)
+    for v in {**w, **b}.values():
+        assert v.dtype == torch.float32 and torch.isfinite(v).all()
+    blk = build_block(spec, w, b)
+    with torch.no_grad():
+        out = blk(prefix(x[:2]))
+    assert tuple(out.shape) == (2, cout, x.shape[-2], x.shape[-1])
+    assert len(prov["diagnostics"]["latent_to_kernel"]["r2_per_kernel"]) == cout
+    json.dumps(prov, default=str)
+    assert prov["labels_used"] is False and prov["mask_used"] is False and prov["method"] == "spifil3"
+
+
+def test_unsupported_block_is_infeasible(data):
