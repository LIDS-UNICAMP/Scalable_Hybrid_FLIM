+def test_prefix_untouched(data):
+    _, _, td = data
+    prefix = _prefix()
+    before = {k: v.clone() for k, v in prefix.state_dict().items()}
+    fp = base.prefix_fingerprint(prefix)
+    seen = []
+    prefix.register_forward_hook(lambda m, i, o: seen.append((m.training, any(p.requires_grad for p in m.parameters()))))
+    _, _, prov = Spifil3Predictive().fit(prefix, td, _spec(), _ctx())
+    after = prefix.state_dict()
+    assert all(torch.equal(before[k], after[k]) for k in before)
+    assert base.prefix_fingerprint(prefix) == fp == prov["prefix_state_sha256"]
+    assert all(p.grad is None for p in prefix.parameters())
+    assert seen and all(tr is False and rg is False for tr, rg in seen)  # eval + congelado durante o fit
+    assert prefix.training is True and all(p.requires_grad for p in prefix.parameters())  # estado restaurado
+
+
+# ---------------------------------------------------------------- preditor descartado
+
