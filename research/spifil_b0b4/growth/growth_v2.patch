+# Cadeia de crescimento progressivo B0 -> B4 (ga_search/hmodehb/growth_chain.py). Config de CRESCIMENTO;
+# treino/dados/régua vêm do base.yaml do H-MODEHB (fitness v2 ORIG). O hash dos dois vai para o estado.
+n_parents: 4            # pais por faixa (frente de Pareto kappa ORIG-val x FLOPs 2·MAC)
+n_children: 8           # filhos por geração
+generations: 2          # gerações por faixa
+eta: 3                  # promoção f_low -> f_high: ceil(aceitos / eta)
+fid_low: 15             # triagem
+fid_high: 45            # aceitação final
+delta: 0.0              # aceita se kappa_val(filho) >= kappa_val(pai) + delta
+require_improvement: false   # true: alpha=0 (= pai) não conta como aceito
+protect: lowlr          # herdados: lowlr (0,01 x lr) | freeze | full; novos: lr cheio
+init_method: spifil0    # KernelInitializer do A2 nos canais novos: spifil0 | spifil1 | spifil2
+init_config: {}
+spifil_images_per_class: 4
+start_band: B0
+end_band: B4
+hard_cap: 5500000
+max_ops: 12
+residual_act: silu
+seeds:
+  registry: research/spifil_b0b4/agent1/seed_registry.csv
+  regua: ORIG
+  bands: [B0]
+  checkpoints: []
+  external_small: true  # "SPiFiL pequeno" (entra na faixa em que cair; RS ~B2)
+  top_k: 4
+ssl: lejepa
+reg: sigreg
+ae_target: pixel
+ae_schedule: joint
+lr: 1.0e-3
+lr_ae: 1.0e-3
+wise_alphas: [0.0, 0.25, 0.5, 0.75, 1.0]
+preservation_images: 8
+preservation_tol: 1.0e-5
+oom: {retries: 10, sleep_s: 300}
+test_channel: true
+debug_train: null
+debug_val: null
