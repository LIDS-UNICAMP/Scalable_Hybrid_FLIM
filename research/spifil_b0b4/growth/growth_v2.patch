+# ---------------------------------------------------------------- regua em TODA decisao (A1b)
+def _ok(**kw):
+    r = {"status": "ok", "quality": 0.4, "kappa_val_orig": 0.4, "decision_rulers": [FV.ruler_sig(H.SPEC)],
+         "wise_alpha": 0.5, "aux": {"wise_kappas": {"0.0": 0.3, "0.5": 0.4, "1.0": 0.35}}}
