@@ -0,0 +1,48 @@
+"""Família de referência plana B0 -> B4 por morfismo exato: preservação em toda a cadeia (224 px, eval, fp32)."""
+import pytest
+import torch
+
+from _bb_helpers import TOL, assert_exact
+from ga_search.backbones.family import REF_FLAT, build_reference_chain, reference_family_specs
+from ga_search.backbones.spec import BUDGETS, GrowthSpec
+
+
+@pytest.fixture(scope="module")
+def chain():
+    x = torch.rand(2, 3, 224, 224, generator=torch.Generator().manual_seed(7))
+    models, edges, log = build_reference_chain(x, seed=0, data={"source": "synthetic_uniform01", "seed": 7})
+    return x, models, edges, log
+
+
+def test_chain_targets_and_bands(chain):
+    _, models, edges, _ = chain
+    specs, _ = reference_family_specs()
+    assert [m.spec.arch_hash() for m in models] == [s.arch_hash() for s in specs]
+    for k, m in zip(REF_FLAT, models):
+        assert m.spec.budget_class == k and m.spec.cost.params_total <= BUDGETS[k]
+    assert len(edges) == 4
+
+
+def test_every_edge_exact(chain):
+    _, models, edges, _ = chain
+    for g, p, c in zip(edges, models[:-1], models[1:]):
+        assert_exact(g)
+        assert g.parent == p.spec.id and g.child == c.spec.id
+        assert g.inheritance["head"] == "inherit_zero_cols"
+        assert g.inheritance["totals"]["inherited"] == p.spec.cost.params_total
+        assert g.inheritance["totals"]["inherited"] + g.inheritance["totals"]["new"] == c.spec.cost.params_total
+        assert g.params["delta"] == c.spec.cost.params_total - p.spec.cost.params_total
+        assert g.flops["child"] == 2 * g.macs["child"]
+        assert GrowthSpec.from_json(g.to_json()).id == g.id
+
+
+@torch.no_grad()
+def test_end_to_end_b0_equals_b4(chain):
+    """Composição: o embedding 1280 do B4 recém-crescido é o do B0 (e o mapa final 14x14 nos canais herdados)."""
+    x, models, _, _ = chain
+    e0, e4 = models[0].eval()(x), models[-1].eval()(x)
+    rel = ((e4 - e0).norm() / e0.norm()).item()
+    assert e0.shape == e4.shape == (2, 1280) and rel <= TOL
+    f0, f4 = models[0].features(x), models[-1].features(x)
+    assert f0.shape[-1] == f4.shape[-1] == 14
+    assert ((f4[:, :f0.shape[1]] - f0).norm() / f0.norm()).item() <= TOL
diff --git a/tests/backbones/test_morphisms.py b/tests/backbones/test_morphisms.py
