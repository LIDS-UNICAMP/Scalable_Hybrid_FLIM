+def test_determinism(data):
+    _, _, td = data
+    spec = _spec()
+    w1, b1, p1 = Spifil3Predictive().fit(_prefix(), td, spec, _ctx(seed=5))
+    w2, b2, p2 = Spifil3Predictive().fit(_prefix(), td, spec, _ctx(seed=5))
+    assert torch.equal(w1["conv.weight"], w2["conv.weight"]) and torch.equal(b1["conv.bias"], b2["conv.bias"])
+    assert p1["diagnostics"]["latent_to_kernel"]["r2_per_kernel"] == p2["diagnostics"]["latent_to_kernel"]["r2_per_kernel"]
+    assert p1["config_sha256"] == p2["config_sha256"]
+    w3, _, _ = Spifil3Predictive().fit(_prefix(), td, spec, _ctx(seed=6))
+    assert not torch.equal(w1["conv.weight"], w3["conv.weight"])
