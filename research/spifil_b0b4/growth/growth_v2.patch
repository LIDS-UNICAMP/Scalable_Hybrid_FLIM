+# ---------------------------------------------------------------- interface base / runner
+
+
+def test_registry_and_validate_init(data):
+    _, _, td = data
+    assert {"spifil3", "spifil3_rand"} <= set(base.available())
+    m = base.get_initializer("spifil3", steps=10)
+    assert isinstance(m, Spifil3Predictive) and m.label_policy == "label_free"
+    assert isinstance(base.get_initializer("spifil3_rand"), Spifil3Rand)
+    spec = _spec()
+    w, b, prov = m.fit(_prefix(), td, spec, _ctx())
+    base.validate_init(prov["effective_spec"], w, b)
+    assert prov["config"]["steps"] == FAST["steps"]  # context.config tem precedência sobre o construtor
+    assert prov["interface_version"] == base.INTERFACE_VERSION
+
+
+def test_init_block_runner_path(data):
+    x, _, td = data
+    genome = {"seed": 7, "layers": [dict(active=True, channels=8, kernel=3, conv="conv", residual=False,
+                                         activation="relu", norm="none", pool="max", dropout=0.0)]}
+    prefix = _prefix()
+    blk, prov = base.get_initializer("spifil3").init_block(genome, 0, prefix, td, _ctx())
+    with torch.no_grad():
+        out = blk(prefix(x[:2]))
+    assert out.shape[:2] == (2, 8) and torch.isfinite(out).all()
+    assert prov["init"] == "spifil3" and prov["in_channels"] == 6
+    assert all(k.startswith(("conv.", "norm.", "skip.")) for k in blk.state_dict())
