+# ─── 5. caso sintético: o padrão estável é escolhido, o instável não ─────────
+def _blobs(n=24, S=32, seed=0):
+    """1 canal: bolhas suaves em [0,3; 0,7] (sem saturação sob o jitter usado)."""
+    g = torch.Generator().manual_seed(seed)
+    yy, xx = torch.meshgrid(torch.arange(S).float(), torch.arange(S).float(), indexing="ij")
+    xs = []
+    for _ in range(n):
+        b = torch.zeros(S, S)
+        for _ in range(4):
+            cy, cx = (torch.rand(2, generator=g) * S).tolist()
+            b += torch.exp(-((yy - cy) ** 2 + (xx - cx) ** 2) / 6.0)
+        xs.append((0.3 + 0.4 * b.clamp(0, 1))[None])
+    return torch.stack(xs), torch.zeros(n, dtype=torch.long)
+
+
+# vistas: flips (geometria exata, correspondência espelhada) + deslocamento DC por vista (jitter)
+FLIP_JITTER = {"crop_scale": (1.0, 1.0), "crop_ratio": (1.0, 1.0), "hflip_p": 0.5, "vflip_p": 0.5,
+               "brightness": 0.0, "contrast": 0.0, "channel_jitter": 0.2}
+DC = [1.0] * 9                                   # instável: responde ao deslocamento DC da vista
+GX = [-1.0, 0, 1, -2, 0, 2, -1, 0, 1]            # instável: troca de sinal sob hflip
+GY = [-1.0, -2, -1, 0, 0, 0, 1, 2, 1]            # instável: troca de sinal sob vflip
+LAP = [0.0, -1, 0, -1, 4, -1, 0, -1, 0]          # ESTÁVEL: simétrico e sem DC
+BANK = torch.tensor([DC, GX, GY, LAP], dtype=torch.float64)
+
+
+def controlled_bank(X, K, gen):
+    return BANK.clone()
+
+
+def test_stable_pattern_selected_unstable_rejected():
+    x, y = _blobs()
+    spec = to_ops_spec({"conv": "conv", "kernel": 3, "channels": 1}, 1)
+    ctx = s2.InitContext(seed=0, device=torch.device("cpu"), layer_idx=0, prefix_id="p",
+                         budget=s2.InitBudget(max_images=24, max_patches=6000),
+                         config={"spifil2": {**FAST, "aug_policy": FLIP_JITTER,
+                                             "candidate_fn": controlled_bank}})
+    w, b, prov = s2.Spifil2Invariant().fit(None, _train_data(x, y), spec, ctx)
+    bank = prov["banks"][0]
+    assert bank["selected_idx"] == [3]                       # o Laplaciano (estável)
+    got = F.normalize(w["conv.weight"].flatten().double(), dim=0)
+    assert float(got @ F.normalize(BANK[3], dim=0)) > 0.999
+    assert bank["candidate_fn"] == "controlled_bank"
+    # as estatísticas medem o que se espera: estável alto, instáveis baixos
+    views, thetas, _ = s2.make_views_with_theta(x, 2, FLIP_JITTER, seed=3)
+    corr = s2.correspondences(thetas[0], thetas[1], (32, 32))
+    cache = s2._Cache(x, views[0], views[1], corr, None)
+    st_ = s2._view_stats(BANK.float(), torch.zeros(4), 3, cache, s2.DEFAULT_CONFIG)
+    stab = st_["stab"]
+    assert float(stab[3]) > 0.8
+    assert float(stab[3]) > float(stab[:3].max()) + 0.25
+    # só flips (sem jitter): DC e Laplaciano são estáveis, os orientados (GX, GY) não -> 2 filtros
+    flip_only = {**FLIP_JITTER, "channel_jitter": 0.0}
+    ctx2 = s2.InitContext(seed=0, device=torch.device("cpu"), layer_idx=0, prefix_id="p",
+                          budget=s2.InitBudget(max_images=24, max_patches=6000),
+                          config={"spifil2": {**FAST, "aug_policy": flip_only,
+                                              "candidate_fn": controlled_bank}})
+    spec2 = to_ops_spec({"conv": "conv", "kernel": 3, "channels": 2}, 1)
+    _, _, prov2 = s2.Spifil2Invariant().fit(None, _train_data(x, y), spec2, ctx2)
+    assert sorted(prov2["banks"][0]["selected_idx"]) == [0, 3]
+    st2 = prov2["banks"][0]["selected"]["stab"]
+    assert min(st2) > 0.8
+
+
+def test_invariance_terms_drive_the_choice():
+    """Com candidatos k-means reais, S2 escolhe filtros mais estáveis que a média do banco e que
+    o controle sem invariância (s2_noinv) — o critério é o que muda a escolha."""
+    x, y = _blobs()
+    spec = to_ops_spec({"conv": "conv", "kernel": 3, "channels": 2}, 1)
+    ctx = s2.InitContext(seed=0, device=torch.device("cpu"), layer_idx=0, prefix_id="p",
+                         budget=s2.InitBudget(max_images=24, max_patches=6000),
+                         config={"spifil2": {**FAST, "aug_policy": FLIP_JITTER, "cand_mult": 6}})
+    _, _, p_inv = s2.Spifil2Invariant().fit(None, _train_data(x, y), spec, ctx)
+    _, _, p_ctl = s2.Spifil2Invariant(variant="s2_noinv").fit(None, _train_data(x, y), spec, ctx)
+    bi, bc = p_inv["banks"][0], p_ctl["banks"][0]
+    assert bi["selected_mean"]["stab"] > bi["candidates_mean"]["stab"]
+    assert bi["selected_mean"]["stab"] > bc["selected_mean"]["stab"]
+    assert p_ctl["variant"] == "s2_noinv" and p_ctl["method_config"]["lam_stab"] == 0.0
+
