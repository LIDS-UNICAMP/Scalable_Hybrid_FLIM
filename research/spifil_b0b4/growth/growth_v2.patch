+    assert sorted(cands[i]["stratum"] for i in idx) == list(BK.BK_NAMES)       # 1 quota por B_k
+    idx = S.stratified_promotions(cands[:3], 2, sc, lambda F, k: select_promotions(F, k), counts={"B0": 5})
