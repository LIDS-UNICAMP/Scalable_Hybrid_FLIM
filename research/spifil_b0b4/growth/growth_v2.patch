+"""BackboneSpec/GrowthSpec: JSON ida-e-volta, hash estável (valor dourado), invariâncias e validação."""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from ga_search.backbones.family import REF_FLAT, flat_spec
+from ga_search.backbones.spec import (BackboneSpec, HeadSpec, LayerSpec, SpecError, StageSpec, band_of,
+                                      canonical_json)
+
+ROOT = Path(__file__).resolve().parents[2]
+
+# Valores dourados: mudar o esquema/canonicalização do hash muda estes valores (exige bump de versão).
+GOLDEN_B0_GEM = "6a77a0a93aa6"
+GOLDEN_B0_MEANSTD = "c7f23392f942"
+
+
+def test_hash_golden_values():
+    assert flat_spec(REF_FLAT["B0"]).hash12 == GOLDEN_B0_GEM
+    assert flat_spec(REF_FLAT["B0"], head=HeadSpec(pooling="meanstd")).hash12 == GOLDEN_B0_MEANSTD
+
+
+def test_hash_stable_across_processes():
+    code = ("import sys; sys.path.insert(0, %r); from ga_search.backbones.family import flat_spec, REF_FLAT; "
+            "print(flat_spec(REF_FLAT['B3']).arch_hash())" % str(ROOT))
+    outs = {subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, check=True,
+                           env={"PYTHONHASHSEED": str(s), "PATH": "/usr/bin:/bin"}).stdout.strip() for s in (0, 1, 2)}
+    assert outs == {flat_spec(REF_FLAT["B3"]).arch_hash()}
+
+
+def test_hash_invariances():
+    a = flat_spec(REF_FLAT["B2"])
+    b = a.copy()
+    b.dataset, b.split, b.budget_class = "flowers", 3, "B2"
+    b.cost.params_total, b.cost.macs = 123, 456
+    b.provenance.parent, b.provenance.notes = "x", ["y"]
+    for L in b.layers():
+        L.init = "spifil3"                       # proveniência do peso, não arquitetura
+    assert a.arch_hash() == b.arch_hash()
+    c = a.copy()
+    c.stages[0].layers[0].channels += 1
+    d = a.copy()
+    d.head.pooling = "moments"
+    e = a.copy()
+    e.stages[1].layers[0].norm = "batch"
+    assert len({a.hash12, c.hash12, d.hash12, e.hash12}) == 4
+
+
+def test_json_roundtrip_and_tamper_detection():
+    a = flat_spec(REF_FLAT["B1"], dataset="remote_sensing", budget_class="B1")
+    a.extras_not_counted = {"ae_decoders": 12345, "ssl_projector": 999}
+    s = a.to_json()
+    b = BackboneSpec.from_json(s)
+    assert b.to_json() == s and b.id == a.id == f"remote_sensing/B1/{a.hash12}"
+    d = json.loads(s)
+    d["stages"][0]["layers"][0]["channels"] = 65
+    with pytest.raises(SpecError):
+        BackboneSpec.from_json(json.dumps(d))
+    assert canonical_json({"b": 1, "a": [1, 2]}) == '{"a":[1,2],"b":1}'
+
+
+def test_validation_rules():
+    with pytest.raises(SpecError):
+        HeadSpec(embed_dim=1024).validate()                          # R11: nunca < 1280
+    HeadSpec(embed_dim=1536).validate()
+    bad = flat_spec(REF_FLAT["B0"])
+    bad.stages[0].layers[0].residual = "identity"                    # 24 -> 48: identity impossível
+    with pytest.raises(SpecError):
+        bad.validate()
+    bad2 = flat_spec(REF_FLAT["B0"])
+    bad2.stages = [bad2.stages[1], bad2.stages[0]]                   # ordem de estágios errada
+    with pytest.raises(SpecError):
+        bad2.validate()
+    inc = BackboneSpec(stem=LayerSpec(channels=8, pool="max"),
+                       stages=[StageSpec("abstract", [LayerSpec(channels=10, conv="inception")])]).normalize()
+    assert inc.stages[0].layers[0].branches == [["b1", 1, 4], ["b3", 3, 2], ["b5", 5, 2], ["pool", 1, 2]]
+    inc.validate()
+
+
+def test_bands():
+    assert band_of(300_000) == "B0" and band_of(300_001) == "B1" and band_of(5_500_000) == "B4"
+    with pytest.raises(SpecError):
+        band_of(5_500_001)
