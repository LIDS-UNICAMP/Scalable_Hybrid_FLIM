+"""CPU tests do runner de ablação (sem treino: plano, parsing, aplicabilidade, idempotência, réguas)."""
+import json
+
+import pytest
+import torch
+
+from ga_search.abstract_init import run_ablation as R
+from ga_search.abstract_init.base import get_initializer
+from ga_search.abstract_init.genomes import GENOMES, get_genome
+
+
+def test_parse_and_split_inits():
+    assert R._split_inits("spifil,random,s0plus:knn_smooth=5,whiten=false,spifil1") == \
+        ["spifil", "random", "s0plus:knn_smooth=5,whiten=false", "spifil1"]
+    assert R.parse_init("s0plus:knn_smooth=5,whiten=false") == ("s0plus", {"knn_smooth": 5, "whiten": False})
+    assert R.parse_init("spifil2:variant=s2_noinv") == ("spifil2", {"variant": "s2_noinv"})
+    assert R.init_tag("s0data:images_total=256") == "s0data-images_total256"
+    assert R.run_name("rs_b1", "spifil", "joint", 42) == "rs_b1__spifil__joint__s42"
+
+
+def test_plan_order_spifil_before_random_and_unique():
+    plan = R.build_plan(["rs_b1"], ["random", "s0plus", "spifil"], ["noae", "joint"], [42, 1042])
+    assert len(plan) == 12 and len({p["name"] for p in plan}) == 12
+    for i, p in enumerate(plan):
+        if p["init"] == "random":
+            src = R.run_name(p["genome"], "spifil", p["ae"], p["seed"])
+            assert any(q["name"] == src for q in plan[:i])
+
+
+def test_cli_validation():
+    a = R.parse_args(["--dataset", "remote_sensing", "--inits", "spifil,s0plus:knn_smooth=3,whiten=0",
+                      "--seeds", "1,2", "--ae", "joint"])
+    assert a.inits == ["spifil", "s0plus:knn_smooth=3,whiten=0"] and a.seeds == [1, 2]
+    with pytest.raises(SystemExit):
+        R.parse_args(["--dataset", "x", "--ae", "foo"])
+
+
+def test_genomes_exact_and_embed_dim():
+    for name, info in GENOMES.items():
+        g = get_genome(name, info["dataset"])["genome"]
+        assert len(g["layers"]) == 8 and int(g["embed_dim"]) >= 1280          # R11
+    g = get_genome("rs_b1", "remote_sensing")["genome"]
+    assert [L["channels"] for L in g["layers"][:2]] == [73, 287] and g["seed"] == 42
+    with pytest.raises(ValueError):
+        get_genome("rs_b1", "flowers")
+    s = get_genome("seed_small", "remote_sensing", n_classes=14)["genome"]
+    assert s["depth"] == 6 and all(L["conv"] == "conv" for L in s["layers"][:6]) and s["embed_dim"] >= 1280
+
+
+def test_applicability_spifil3():
+    pytest.importorskip("ga_search.abstract_init.spifil3")
+    rs = get_genome("rs_b1", "remote_sensing")["genome"]                     # layer1 = dwsep
+    seed = get_genome("seed_small", "remote_sensing", n_classes=14)["genome"]
+    s3 = get_initializer("spifil3")
+    assert R.applicability(s3, rs) == ["layer1:dwsep"]
+    assert R.applicability(s3, seed) == []
+    assert R.applicability(get_initializer("spifil0"), rs) == []
+
+
+def test_ruler_cfgs_follow_R1():
+    o = R._ruler_cfg("orig", {"cov_k": 64, "max_train": 4000, "wise_alphas": [0, 1]})
+    c = R._ruler_cfg("cov", {"cov_k": 64})
+    assert (o["readout"], o["scaler"], o["C"], o["kappa_weight"], o["solver"]) == ("head", "none", 100, 1.0, "libsvm")
+    assert (c["readout"], c["scaler"], c["C"]) == ("cov_head", "standard", 100)
+    assert o["wise_alphas"] == [0, 1] and o["max_train"] == 4000
+
+
+def test_blend_matches_wise_formula():
+    enc, head = torch.nn.Linear(3, 2), torch.nn.Linear(2, 2)
+    anchor = {"encoder": {k: torch.zeros_like(v) for k, v in enc.state_dict().items()},
+              "head": {k: torch.zeros_like(v) for k, v in head.state_dict().items()}}
+    trained = {"encoder": {k: torch.ones_like(v) for k, v in enc.state_dict().items()},
+               "head": {k: torch.ones_like(v) for k, v in head.state_dict().items()}}
+    R._blend(enc, head, anchor, trained, 0.25)
+    assert torch.allclose(enc.weight, torch.full_like(enc.weight, 0.25))
+
+
+def test_idempotence_and_quarantine(tmp_path):
+    args = R.parse_args(["--dataset", "remote_sensing", "--out-root", str(tmp_path), "--fidelity", "1"])
+    r = R.Runner(args)
+    d = r.cand_dir("x")
+    d.mkdir(parents=True)
+    (d / "encoder.pt").write_text("partial")
+    assert r.done("x") is None
+    r._quarantine_partial("x")
+    assert not d.exists()
+    moved = list(d.parent.glob("f1.interrompido_*"))
+    assert len(moved) == 1 and (moved[0] / "encoder.pt").exists()         # nada é apagado
+    d.mkdir(parents=True)
+    R._atomic_json(d / "ablation.json", {"status": "ok"})
+    assert r.done("x") == {"status": "ok"}
+    r._quarantine_partial("x")
+    assert d.exists()
+
+
+def test_jsonl_append_and_summary(tmp_path, capsys):
+    p = tmp_path / "r.jsonl"
+    for s, k in ((42, 0.5), (43, 0.7)):
+        R._append_jsonl(p, {"run": f"a{s}", "status": "ok", "genome": "g", "init": "spifil", "ae": "joint",
+                            "fidelity": 45.0, "kappa_val_ORIG": k, "kappa_val_COV": k + 0.1})
+    R._append_jsonl(p, {"run": "b", "status": "failed", "genome": "g", "init": "random", "ae": "joint",
+                        "fidelity": 45.0})
+    R.summarize(p)
+    out = capsys.readouterr().out
+    assert "0.6000±0.1000" in out and "random" not in out
+    assert len(p.read_text().splitlines()) == 3 and all(json.loads(x) for x in p.read_text().splitlines())
+
+
+def test_thread_env_set_on_import():
+    import os
+    assert os.environ.get("OPENBLAS_NUM_THREADS") == "2" or "--keep-thread-env" in __import__("sys").argv
+
+
+def test_protect_override_naming_and_twin_source():
+    assert R.run_name("rs_b1", "spifil", "joint", 42) == "rs_b1__spifil__joint__s42"          # nomes antigos
+    assert R.run_name("rs_b1", "spifil", "joint", 42, "lowlr") == "rs_b1__spifil__joint__s42__plowlr"
+    plan = R.build_plan(["rs_b1"], ["spifil", "random"], ["joint"], [42], protect="lowlr")
+    assert [p["name"] for p in plan] == ["rs_b1__spifil__joint__s42__plowlr", "rs_b1__random__joint__s42__plowlr"]
+    assert all(p["protect"] == "lowlr" for p in plan)
+    a = R.parse_args(["--dataset", "remote_sensing", "--protect", "lowlr"])
+    assert a.protect == "lowlr"
