+def test_r2_positive_on_structured_synthetic():
+    x, y = _images(n=24, size=24, seed=3)
+    td = _train_data(x, y)
+    spec = _spec(cin=3, cout=6)
+    _, _, prov = Spifil3Predictive().fit(None, td, spec, _ctx(steps=40))
+    lk = prov["diagnostics"]["latent_to_kernel"]
+    assert lk["holdout_mode"] == "images"
+    assert lk["r2_median"] > 0.0, lk
+    assert all(r > 0 for r in lk["r2_fit_per_kernel"]), lk["r2_fit_per_kernel"]
+    assert lk["lambda"] in lk["lambda_grid"]
