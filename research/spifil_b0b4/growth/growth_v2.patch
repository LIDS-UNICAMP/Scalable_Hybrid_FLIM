+"""Testes do SPiFiL-1 (protótipos hierárquicos) — CPU, dados sintéticos (desenho §8.1)."""
+from __future__ import annotations
+
+import json
+
+import pytest
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from ga_search.abstract_init.base import (InfeasibleCandidate, InitBudget, InitContext, TrainData,
+                                          assemble_block, get_initializer, prefix_fingerprint, validate_init)
+from ga_search.abstract_init.spifil1 import (Spifil1Prototypes, dense_patches_at, fold_whitening,
+                                             mean_removal_matrix, select_prototypes, spherical_kmeans,
+                                             zca_matrix)
+from ga_search.modehb.spifil_ops import to_ops_spec
+
+S = 32
+N_IMG = 12
+SMALL = {"positions_per_image": 64, "kmeans": {"iters": 10}, "batch_size": 4}
+
+
+# ─── dados sintéticos ─────────────────────────────────────────────────────────
+
+def _images(seed=0, n=N_IMG):
+    g = torch.Generator().manual_seed(seed)
+    yy, xx = torch.meshgrid(torch.arange(S).float(), torch.arange(S).float(), indexing="ij")
+    xs, ys = [], []
+    for i in range(n):
+        c = i % 3
+        if c == 0:
+            pat = 0.5 + 0.5 * torch.sin(yy * 0.8 + float(torch.rand(1, generator=g)) * 6)
+        elif c == 1:
+            pat = 0.5 + 0.5 * torch.sin(xx * 0.8 + float(torch.rand(1, generator=g)) * 6)
+        else:
+            cy, cx = (torch.rand(2, generator=g) * S).tolist()
+            pat = torch.exp(-((yy - cy) ** 2 + (xx - cx) ** 2) / 40.0)
+        img = torch.stack([pat, 0.5 * pat + 0.25, 1 - pat]) + 0.05 * torch.randn(3, S, S, generator=g)
+        xs.append(img.clamp(0, 1))
+        ys.append(c)
+    return torch.stack(xs), torch.tensor(ys)
+
+
+X_TRAIN, Y_TRAIN = _images(0)
+
+
+def _train_data(labels=None, *, split="train", policy="supervised", poison=False, bs=4):
+    y_all = Y_TRAIN if labels is None else labels
+
+    class Poison:
+        def __getattr__(self, name):
+            raise AssertionError("rótulo lido pela versão label-free")
+
+        def __getitem__(self, i):
+            raise AssertionError("rótulo lido pela versão label-free")
+
+    def factory(seed):
+        order = torch.randperm(N_IMG, generator=torch.Generator().manual_seed(seed))
+        for s in range(0, N_IMG, bs):
+            idx = order[s:s + bs]
+            yield X_TRAIN[idx], (Poison() if poison else y_all[idx])
+
+    return TrainData(loader_factory=factory, split_key=split, split_fingerprint="synthetic-train",
+                     n_classes=3, image_size=S, n_images=N_IMG, label_policy=policy, mask_policy="no_mask")
+
+
+class Prefix(nn.Sequential):
+    pass
+
+
+def _prefix(cout=8, dead=0, seed=0):
+    torch.manual_seed(seed)
+    conv = nn.Conv2d(3, cout, 3, padding=1)
+    if dead:
+        with torch.no_grad():
+            conv.weight[:dead].zero_()
+            conv.bias[:dead] = -1.0            # ReLU sempre 0 → canal morto
+    p = Prefix(conv, nn.ReLU(), nn.MaxPool2d(3, 2, 1))
+    p.out_channels = cout
+    return p.eval()
+
+
+def _ctx(seed=7, budget=None, **cfg):
+    return InitContext(seed=seed, device=torch.device("cpu"), layer_idx=1, prefix_id="p",
+                       budget=budget or InitBudget(max_images=N_IMG, max_patches=5000),
+                       config={**SMALL, **cfg})
+
+
+def _spec(conv="conv", k=3, ch=12, cin=8, pool="max", residual=False, act="relu"):
+    layer = {"conv": conv, "kernel": k, "channels": ch, "activation": act, "norm": "none",
+             "pool": pool, "residual": residual}
+    return to_ops_spec(layer, cin)
+
+
+SPECS = {
+    "conv_k1": _spec(k=1), "conv_k3": _spec(k=3), "conv_k5": _spec(k=5), "conv_k7": _spec(k=7),
+    "pointwise": _spec("pointwise", k=1, ch=10),
+    "depthwise_m1": _spec("depthwise", k=3, ch=8), "depthwise_m2": _spec("depthwise", k=3, ch=16),
+    "dwsep": _spec("dwsep", k=3, ch=12), "inception": _spec("inception", ch=13),
+    "residual_identity": _spec(k=3, ch=8, residual=True),
+    "residual_project": _spec(k=3, ch=12, residual=True),
+    "residual_project_narrow": _spec(k=3, ch=5, residual=True, pool="none"),
+    "conv_avgpool": _spec(k=3, ch=6, pool="avg"),
+}
+
+
+def _fit(spec, ctx=None, td=None, prefix=None, **kw):
+    init = Spifil1Prototypes(**kw)
+    prefix = _prefix() if prefix is None else prefix
+    return init, prefix, init.fit(prefix, td or _train_data(), spec, ctx or _ctx())
+
+
+# ─── shapes ──────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("name", list(SPECS))
+def test_shapes_all_block_types(name):
+    spec = SPECS[name]
+    _, prefix, (w, b, prov) = _fit(spec)
+    eff = prov["effective_spec"]
+    validate_init(eff, w, b)
+    blk = assemble_block(eff, w, b)
+    for k in w:
+        assert k.endswith("weight")
+    for k in b:
+        assert k.endswith("bias")
+    with torch.no_grad():
+        f = prefix(X_TRAIN[:2])
+        out = blk.eval()(f)
+    h = f.shape[-1]
+    exp_h = (h - 1) // 2 + 1 if spec["pool"] != "none" else h
+    assert out.shape == (2, int(eff["channels"]), exp_h, exp_h)
+    assert torch.isfinite(out).all()
+    if spec["conv"] == "depthwise":
+        assert w["conv.weight"].shape == (spec["channels"], 1, 3, 3)
+    if spec["conv"] == "dwsep":
+        assert w["conv.depthwise.weight"].shape == (8, 1, 3, 3)
+        assert w["conv.pointwise.weight"].shape == (12, 8, 1, 1)
+    if spec["conv"] == "inception":
+        assert sum(int(br[2]) for br in eff["inception_branches"]) == 13
+        assert set(w) == {f"conv.branches.{n}.weight" for n in ("b1", "b3", "b5")} | {
+            "conv.branches.pool.proj.weight"}
+    if spec.get("skip") == "project":
+        assert w["skip.weight"].shape == (spec["channels"], 8, 1, 1)
+    if spec.get("skip") == "identity":
+        assert "skip.weight" not in w
+    json.dumps(prov)
+
+
+def test_input_layer_prefix_none_and_registry():
+    init = get_initializer("spifil1")
+    assert isinstance(init, Spifil1Prototypes)
+    spec = _spec(k=5, ch=9, cin=3)
+    w, b, prov = init.fit(None, _train_data(), spec, _ctx())
+    validate_init(prov["effective_spec"], w, b)
+    assert w["conv.weight"].shape == (9, 3, 5, 5)
+
+
+def test_init_block_genome_route():
+    """O caminho do runner (KernelInitializer.init_block) monta o bloco com o mesmo spec."""
+    genome = {"layers": [{"conv": "conv", "kernel": 3, "channels": 10, "activation": "relu",
+                          "norm": "none", "pool": "max"}]}
+    blk, prov = Spifil1Prototypes().init_block(genome, 0, _prefix(), _train_data(), _ctx())
+    assert prov["effective_spec"]["channels"] == 10 and prov["in_channels"] == 8
+    assert blk.conv.weight.shape == (10, 8, 3, 3)
+
+
+# ─── determinismo ────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("name", ["conv_k3", "dwsep", "inception", "residual_project"])
+def test_deterministic_with_seed(name):
+    spec = SPECS[name]
+    _, _, (w1, b1, p1) = _fit(spec, _ctx(seed=3))
+    _, _, (w2, b2, p2) = _fit(spec, _ctx(seed=3))
+    for k in w1:
+        assert torch.equal(w1[k], w2[k]), k
+    for k in b1:
+        assert torch.equal(b1[k], b2[k]), k
+    assert p1["data"]["images_sha256"] == p2["data"]["images_sha256"]
+    _, _, (w3, _, _) = _fit(spec, _ctx(seed=4))
+    assert any(not torch.equal(w1[k], w3[k]) for k in w1)
+
+
+# ─── só treino ───────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("split", ["val", "test"])
+def test_refuses_non_train_split(split):
+    with pytest.raises(ValueError):
+        _fit(SPECS["conv_k3"], td=_train_data(split=split))
+
+
+def test_reads_only_train_loader_and_budget():
+    """Só ``loader_factory`` (treino) é lido, até max_images; donors/diag_batch nunca são usados."""
+    calls = []
+    base = _train_data()
+
+    def factory(seed):
+        calls.append(seed)
+        yield from base.loader_factory(seed)
+
+    class Boom:
+        def __getattr__(self, n):
+            raise AssertionError("acesso a dado fora do loader de treino")
+
+        def __iter__(self):
+            raise AssertionError("acesso a doadores")
+
+        def __len__(self):
+            raise AssertionError("acesso a doadores")
+
+    td = TrainData(donors=Boom(), loader_factory=factory, split_key="train", split_fingerprint="x",
+                   n_classes=3, image_size=S, n_images=N_IMG)
+    ctx = _ctx(budget=InitBudget(max_images=6, max_patches=300))
+    ctx.diag_batch = Boom()
+    _, _, (w, b, prov) = _fit(SPECS["conv_k3"], ctx, td)
+    assert calls == [ctx.seed]
+    assert prov["data"]["n_images"] == 6
+    assert prov["data"]["split_key"] == "train"
+    assert prov["data"]["n_patches"] <= 300
+    # hash = exatamente as 6 primeiras imagens da ordem semeada do treino
+    order = torch.randperm(N_IMG, generator=torch.Generator().manual_seed(ctx.seed))[:6]
+    import hashlib
+    assert prov["data"]["images_sha256"] == hashlib.sha256(
+        X_TRAIN[order].contiguous().numpy().tobytes()).hexdigest()
+
+
+def test_time_budget_raises_infeasible():
+    ctx = _ctx(budget=InitBudget(max_images=N_IMG, max_patches=5000, max_seconds=0.0))
+    with pytest.raises(InfeasibleCandidate) as e:
+        _fit(SPECS["conv_k3"], ctx)
+    assert "budget" in e.value.reason
+
+
+# ─── label-free ──────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("name", ["conv_k3", "depthwise_m2", "inception", "residual_project"])
+def test_label_free_invariant_to_label_permutation(name):
+    spec = SPECS[name]
+    perm = torch.tensor([2, 0, 1])
+    y_perm = perm[Y_TRAIN]
+    y_rand = torch.randint(0, 3, (N_IMG,), generator=torch.Generator().manual_seed(9))
+    outs = [_fit(spec, td=_train_data(lab))[2] for lab in (None, y_perm, y_rand)]
+    outs.append(_fit(spec, td=_train_data(poison=True))[2])       # rótulo envenenado: nunca lido
+    w0, b0, p0 = outs[0]
+    assert p0["labels_used"] is False and p0["label_source"] == "none" and p0["mask_used"] is False
+    assert p0["variant"] == "spifil1-lf"
+    for w, b, _ in outs[1:]:
+        for k in w0:
+            assert torch.equal(w0[k], w[k]), k
+        for k in b0:
+            assert torch.equal(b0[k], b[k]), k
+
+
+def test_supervised_version_is_marked():
+    _, _, (w, b, prov) = _fit(SPECS["conv_k3"], _ctx(label_policy="supervised"))
+    assert prov["labels_used"] is True and prov["label_source"] == "image_labels"
+    assert prov["variant"] == "spifil1-sup" and prov["mask_used"] is False
+    assert sum(prov["banks"][0]["filters_per_class"].values()) == 12
+    validate_init(prov["effective_spec"], w, b)
+    # dados marcados como label_free forçam a versão sem rótulos (registrado)
+    _, _, (_, _, prov2) = _fit(SPECS["conv_k3"], _ctx(label_policy="supervised"),
+                               _train_data(policy="label_free", poison=True))
+    assert prov2["labels_used"] is False
+    assert "label_policy_forced_label_free_by_train_data" in prov2["approximations"]
+
+
+# ─── dobra do whitening ──────────────────────────────────────────────────────
+
+def test_fold_whitening_exact_formula():
+    g = torch.Generator().manual_seed(0)
+    d = 27
+    a = torch.randn(200, d, generator=g, dtype=torch.float64) @ torch.randn(d, d, generator=g, dtype=torch.float64)
+    mu = a.mean(0)
+    for mean_only in (False, True):
+        p = mean_removal_matrix(d, mean_only)
+        xp = (a - mu) @ p
+        z, zinv, _ = zca_matrix(xp.T @ xp / a.shape[0], 0.01)
+        assert torch.allclose(z, z.T) and torch.allclose(z @ zinv, torch.eye(d, dtype=torch.float64), atol=1e-8)
+        c = torch.randn(5, d, generator=g, dtype=torch.float64)
+        w, b = fold_whitening(c, z, p, mu)
+        x = torch.randn(50, d, generator=g, dtype=torch.float64)
+        explicit = (z @ p @ (x - mu).T).T @ c.T           # c · Z·P·(x − μ)
+        assert torch.allclose(x @ w.T + b, explicit, atol=1e-9)
+
+
+@pytest.mark.parametrize("cfg", [{"patch_norm": "none", "unit_response_std": False},
+                                 {"patch_norm": "mean_only", "unit_response_std": False},
+                                 {"patch_norm": "mean_only", "unit_response_std": True}])
+def test_folded_conv_equals_explicit_whitened_response(cfg):
+    """conv(F)[p] = s · c·Z·P·(F_p − μ) em TODAS as posições (forma explícita contra a conv)."""
+    spec = SPECS["conv_k3"]
+    init, prefix, (w, b, prov) = _fit(spec, _ctx(**cfg))
+    it = init.last_fit_internals["conv"]
+    with torch.no_grad():
+        f = prefix(X_TRAIN[:3])
+        out = F.conv2d(f, w["conv.weight"], b["conv.bias"], padding=1)
+    h = f.shape[-1]
+    r, c = torch.meshgrid(torch.arange(h), torch.arange(h), indexing="ij")
+    pr, pc = r.reshape(1, -1).expand(3, -1), c.reshape(1, -1).expand(3, -1)
+    xp = dense_patches_at(f, pr, pc, 3).double()               # (3·HW, D)
+    # sanity: a ordem dos patches é a da conv (sem dobra)
+    ref = (xp @ w["conv.weight"].double().flatten(1).T + b["conv.bias"].double())
+    got = out.double().permute(0, 2, 3, 1).reshape(-1, out.shape[1])
+    assert torch.allclose(ref, got, atol=1e-4, rtol=1e-4)
+    explicit = ((xp - it["mu"]) @ it["p"] @ it["z"]) @ it["c"].T * it["scale"]
+    assert torch.allclose(explicit, got, atol=1e-4, rtol=1e-4), (explicit - got).abs().max()
+    assert "zca_folded" in prov["approximations"]
