+# ───────────────────────────────────────────── MKL DLASCL: patches não finitos -> InfeasibleCandidate antes do eigh
+def _learn(feats):
+    patches = types.SimpleNamespace(feats=feats)
+    return types.SimpleNamespace(n_layers=1, state=[types.SimpleNamespace(patches=patches)])
+
