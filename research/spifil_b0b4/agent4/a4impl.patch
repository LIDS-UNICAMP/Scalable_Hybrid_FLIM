+"""H-MODEHB B0-B4 (Agente 4): MO-DEHB hierarquico com integridade de busca.
+
+Namespace novo e isolado: importa as primitivas de ``ga_search.modehb`` (MODEHB, Evaluator, strata,
+lemonade) sem modifica-las. Buscas existentes (H-MODEHB, H-LEM, H-SEED, PNAS-CS) nao mudam.
+
+Entrada: ``python -m ga_search.hmodehb.run_hsearch --arm A --dataset remote_sensing``.
+Desenho: research/spifil_b0b4/agent4/prep_desenho_modehb_hierarquico.md (secoes 5, 6.1, 7, 10).
+"""
diff --git a/ga_search/hmodehb/bk.py b/ga_search/hmodehb/bk.py
new file mode 100644
index 0000000..f52a6e6
--- /dev/null
+++ b/ga_search/hmodehb/bk.py
@@ -0,0 +1,70 @@
+"""Subpopulacoes B0-B4: faixas FIXAS de parametros (encoder + cabeca >= 1280) e teto duro de 5,5M.
+
+Faixas (lo, hi] como em ``strata.stratum_of``; 300000 -> B0, 300001 -> B1; > 5.500.000 -> None
+(infeasivel, nunca gerado e nunca aceito). Sem fator 1,05 (o PNAS-CS usa 5,775M: viola a missao).
+Decoders do AE local e projetores SSL ficam fora da contagem (registrados a parte pelo avaliador).
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+BK_BANDS = (("B0", 0, 300_000), ("B1", 300_000, 800_000), ("B2", 800_000, 1_500_000),
+            ("B3", 1_500_000, 3_000_000), ("B4", 3_000_000, 5_500_000))
+HARD_CAP = 5_500_000
+BK_NAMES = tuple(n for n, _, _ in BK_BANDS)
+MIN_EMBED_DIM = 1280     # decisao do usuario 17/11: cabeca de alta dimensao obrigatoria
+
+
+class BandError(ValueError):
+    """Config de estratos diferente das faixas fixas B0-B4."""
+
+
+def bands_dict() -> dict:
+    return {n: [lo, hi] for n, lo, hi in BK_BANDS}
+
+
+def bk_of(params) -> Optional[str]:
+    """Faixa de uma contagem de parametros; None acima do teto duro."""
+    if params is None:
+        return None
+    p = int(params)
+    if p > HARD_CAP or p < 0:
+        return None
+    for n, lo, hi in BK_BANDS:
+        if lo < p <= hi or (lo == 0 and p <= hi):
+            return n
+    return None
+
+
+def _norm_strata(raw):
+    if raw is None:
+        return None
+    if isinstance(raw, dict):
+        raw = [(k, v[0], v[1]) for k, v in raw.items()]
+    return tuple((str(n), int(lo), int(hi)) for n, lo, hi in raw)
+
+
+def stratified_block(user: Optional[dict] = None) -> dict:
+    """Bloco ``search.stratified`` com as faixas B0-B4 impostas.
+
+    O usuario pode ajustar os knobs de promocao (min_share, explore_*, calibration, ...), mas NAO as
+    faixas nem o teto: se vierem diferentes, ``BandError`` (nunca uma troca silenciosa)."""
+    u = dict(user or {})
+    got = _norm_strata(u.get("strata"))
+    if got is not None and got != BK_BANDS:
+        raise BandError(f"stratified.strata deve ser exatamente {bands_dict()}, veio {u.get('strata')}")
+    cap = u.get("param_cap")
+    if cap is not None and int(cap) != HARD_CAP:
+        raise BandError(f"stratified.param_cap deve ser {HARD_CAP} (teto duro), veio {cap}")
+    u.update(enabled=True, strata=bands_dict(), param_cap=HARD_CAP)
+    ex = [s for s in (u.get("explore_strata") or ["B2", "B3", "B4"]) if s in BK_NAMES]
+    u["explore_strata"] = ex
+    return u
+
+
+def check_strat(sc: dict) -> None:
+    """Confere um ``strat_config`` ja resolvido (MODEHB.strat)."""
+    if sc is None:
+        raise BandError("H-MODEHB exige estratificacao B0-B4 (stratified.enabled)")
+    if tuple(tuple(x) for x in sc["strata"]) != BK_BANDS or int(sc["param_cap"]) != HARD_CAP:
+        raise BandError(f"faixas/teto resolvidos diferem de B0-B4/{HARD_CAP}: {sc['strata']} cap={sc['param_cap']}")
diff --git a/ga_search/hmodehb/fitness_v2.py b/ga_search/hmodehb/fitness_v2.py
new file mode 100644
index 0000000..0ddd15f
--- /dev/null
+++ b/ga_search/hmodehb/fitness_v2.py
@@ -0,0 +1,188 @@
+"""Fitness v2 do H-MODEHB (desenho secao 5).
+
+Objetivos (minimizados, em [0,1]):
+  f0 = 1 - clip(kappa_val_ORIG, 0, 1)
+  f1 = clip(log10(MACs/1e6) / log10(1e11/1e6), 0, 1)       (limites fixos: HV comparavel entre runs)
+
+kappa_val_ORIG = ``core.svm.fit_svm`` linear, C=100, SEM scaler, SEM whitening, sobre o embedding
+``head(encoder(x))`` (dimensao >= 1280), tta=1, kappa_weight=1.0, treino estratificado e semeado
+(``max_train``), validacao INTEIRA. Teste nunca e carregado.
+
+Auxiliares (COV/cov_head+scaler, GTP, macro-F1, label-free, kappa_val_alpha0, ...) vao SO para
+``result["aux"]`` e nunca entram em F. A assinatura ``fitness_sig`` resume a regua; o estado,
+cada job e o id do controller W&B a carregam, e o resume recusa misturar assinaturas.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from typing import Optional, Sequence
+
+from ga_search.hmodehb.bk import MIN_EMBED_DIM
+
+VERSION = "fitness_v2"
+FLOPS_BOUNDS = (1e6, 1e11)
+# valores obrigatorios do bloco eval.svm_fitness (a regua ORIG)
+REQUIRED = {"C": 100.0, "scaler": "none", "readout": "head", "kappa_weight": 1.0, "tta": 1,
+            "whiten": "none", "solver": "libsvm"}
+DEFAULTS = {"max_train": 4000, "wise_alphas": [0.0, 0.25, 0.5, 0.75, 1.0], "gram_reduce": False}
+# chaves de eval.svm_fitness que nao mudam a regua (velocidade / memoria)
+SPEED_KEYS = ("cov_eigh", "cov_eigh_workers", "svm_workers", "svm_ram_gb", "svm_blas_threads", "gram_reduce")
+AUX_ONLY_KEYS = ("cov_k", "aux_cov")
+
+
+class FitnessConfigError(ValueError):
+    """Config de fitness que nao e a regua v2 (ex.: C=0.1, scaler=standard, readout=cov_head)."""
+
+
+class FitnessSigMismatch(RuntimeError):
+    """Resume/replay com uma regua de fitness diferente da gravada no estado."""
+
+
+class NonFiniteFitness(RuntimeError):
+    """Embedding ou loss nao finitos: o candidato falha com reason=nan."""
+
+
+def _same(a, b) -> bool:
+    if isinstance(b, float):
+        try:
+            return math.isclose(float(a), b)
+        except (TypeError, ValueError):
+            return False
+    if isinstance(b, int) and not isinstance(b, bool):
+        try:
+            return int(a) == b
+        except (TypeError, ValueError):
+            return False
+    return str(a).lower() == str(b).lower()
+
+
+def validate_eval(ev: dict) -> dict:
+    """Confere ``cfg["eval"]`` e devolve o bloco svm_fitness efetivo (v2). Erro em qualquer desvio."""
+    if (ev or {}).get("fitness_mode") != "svm_kappa":
+        raise FitnessConfigError("fitness v2 exige eval.fitness_mode: svm_kappa")
+    sv = dict((ev or {}).get("svm_fitness") or {})
+    bad = {k: sv[k] for k, v in REQUIRED.items() if k in sv and not _same(sv[k], v)}
+    if bad:
+        raise FitnessConfigError(f"eval.svm_fitness fora da regua v2 (ORIG): {bad}; exigido {REQUIRED}")
+    if bool(sv.get("dimensional_collapse_penalty", False)):
+        raise FitnessConfigError("fitness v2: penalidade de colapso dimensional proibida (so flag)")
+    out = {**REQUIRED, **DEFAULTS, **sv}
+    out["C"], out["kappa_weight"], out["tta"] = float(out["C"]), float(out["kappa_weight"]), int(out["tta"])
+    out["max_train"] = None if out["max_train"] is None else int(out["max_train"])
+    out["wise_alphas"] = [float(a) for a in (out.get("wise_alphas") or [])]
+    return out
+
+
+def spec(sv: dict, *, val_sha256: str, n_val: Optional[int], dataset: str, split=None) -> dict:
+    """Tudo o que define a regua (o que muda o numero que vira f0/f1)."""
+    return {"v": VERSION, "readout": "head", "min_embed_dim": MIN_EMBED_DIM, "svm": "core.svm.fit_svm",
+            "C": float(sv["C"]), "scaler": "none", "kappa_weight": 1.0, "tta": 1, "whiten": "none",
+            "solver": "libsvm", "max_train": sv.get("max_train"),
+            "wise_alphas": [float(a) for a in sv.get("wise_alphas") or []],
+            "val_sha256": str(val_sha256), "n_val": None if n_val is None else int(n_val),
+            "dataset": str(dataset), "split": split, "flops_bounds": list(FLOPS_BOUNDS)}
+
+
+def signature(sp: dict) -> str:
+    blob = json.dumps(sp, sort_keys=True, separators=(",", ":"), default=str)
+    return hashlib.sha256(blob.encode()).hexdigest()[:12]
+
+
+def objectives(result: dict):
+    """[f0, f1] com os limites fixos (falha -> [1, 1])."""
+    from ga_search.modehb import modehb as M
+    return M.objectives(result, False, {"flops_lo": FLOPS_BOUNDS[0], "flops_hi": FLOPS_BOUNDS[1]})
+
+
+def quality_of(kappa: float) -> float:
+    if kappa is None or not math.isfinite(float(kappa)):
+        raise NonFiniteFitness(f"kappa nao finito: {kappa}")
+    return float(min(max(float(kappa), 0.0), 1.0))
+
+
+# chaves do resultado do Evaluator historico que sao so diagnostico -> aux
+_AUX_FROM_BASE = ("quality_label_free", "fitness_macro_f1", "fitness_balanced_acc", "wise_kappas", "metrics",
+                  "collapse_multiplier", "ssl_final_loss", "quality_raw")
+
+
+def finalize(base: dict, *, kappa: float, nonfinite: bool = False, aux_extra: Optional[dict] = None,
+             alphas: Sequence[float] = ()) -> dict:
+    """Resultado v2 a partir do resultado do ``run_search.Evaluator``.
+
+    ``quality`` = clip(kappa ORIG) SEM multiplicador de colapso; colapso total so vira flag.
+    As chaves que o ``Evaluator.__call__`` historico le continuam presentes (quality_raw = quality,
+    collapse_multiplier = 1.0); os valores antigos vao para ``aux``."""
+    if nonfinite:
+        raise NonFiniteFitness("embedding nao finito na fitness (svm_fitness.nonfinite)")
+    loss = base.get("ssl_final_loss")
+    if loss is not None and not math.isfinite(float(loss)):
+        raise NonFiniteFitness(f"loss SSL final nao finita: {loss}")
+    q = quality_of(kappa)
+    aux = {k: base.get(k) for k in _AUX_FROM_BASE if k in base}
+    aux["quality_legacy"] = base.get("quality")
+    wk = base.get("wise_kappas") or {}
+    if wk:
+        a0 = wk.get("0.0", wk.get("0"))
+        aux["kappa_val_alpha0"] = None if a0 is None else float(a0)
+    aux.update(aux_extra or {})
+    col = base.get("collapse") or {}
+    out = {k: v for k, v in base.items() if k not in ("quality_label_free", "fitness_macro_f1",
+                                                       "fitness_balanced_acc", "wise_kappas", "metrics")}
+    out.update(quality=q, quality_raw=q, collapse_multiplier=1.0, fitness_kappa=float(kappa),
+               kappa_val_orig=float(kappa), fitness_version=VERSION,
+               collapse_total=bool(col.get("total", False)), collapse_dimensional=bool(col.get("dimensional", False)),
+               aux=aux)
+    return out
+
+
+# ────────────────────────────────────────────────────────────────── regua em TODA decisao
+# A1b (17/11): o fitness, o WiSE e a calibracao historicos decidiam por cov_head+StandardScaler enquanto o
+# reportado e ORIG (rho(val COV, teste ORIG) = 0,09; o alpha do WiSE escolhido pelo COV piora o ORIG em 5/11).
+# Aqui cada leitura SVM que DECIDE algo (alpha do WiSE e kappa final; selecao, promocao, calibracao e
+# extensao leem ``quality``/F, derivados dela) carrega um carimbo ``ruler_sig``; o controller recusa
+# (RulerViolation, fatal, nada gravado) qualquer resultado com carimbo diferente da regua da assinatura.
+RULER_KEYS = ("readout", "C", "scaler", "whiten", "tta", "kappa_weight", "solver", "max_train")
+
+
+class RulerViolation(FitnessSigMismatch):
+    """Uma decisao da busca usou uma regua diferente da gravada (ex.: COV no WiSE)."""
+
+
+def ruler(d: dict) -> dict:
+    """Componentes da regua de um spec v2 OU de uma leitura efetiva (readout + kwargs do svm_fitness)."""
+    mt = d.get("max_train")
+    return {"readout": str(d.get("readout", "head")), "C": float(d.get("C", 100.0)),
+            "scaler": str(d.get("scaler", "none")), "whiten": str(d.get("whiten", "none")),
+            "tta": int(d.get("tta", 1)), "kappa_weight": float(d.get("kappa_weight", 1.0)),
+            "solver": str(d.get("solver", "libsvm")), "max_train": None if mt is None else int(mt)}
+
+
+def ruler_sig(d: dict) -> str:
+    return signature(ruler(d))
+
+
+def check_decisions(result: dict, sp: dict) -> None:
+    """Falha se alguma decisao deste resultado nao foi tomada pela regua de ``sp`` (ORIG-val)."""
+    if result.get("status", "ok") != "ok":
+        return
+    want = ruler_sig(sp)
+    got = result.get("decision_rulers")
+    if not got:
+        raise RulerViolation("resultado ok sem carimbo de regua (decision_rulers): decisao nao auditavel")
+    bad = sorted(set(got) - {want})
+    if bad:
+        raise RulerViolation(f"decisao com regua {bad} != {want} (ORIG-val da assinatura)")
+    k = result.get("kappa_val_orig")
+    if k is None or not math.isclose(float(result.get("quality", -1.0)), quality_of(k), abs_tol=1e-12):
+        raise RulerViolation(f"quality {result.get('quality')} != clip(kappa_val_orig={k}): F nao vem da regua ORIG")
+    wk = (result.get("aux") or {}).get("wise_kappas") or {}
+    a = result.get("wise_alpha")
+    if wk and a is not None:            # o WiSE escolhe pelo quality = clip(kappa ORIG), 1o maximo
+        best = max(quality_of(v) for v in wk.values())
+        ka = wk.get(str(a), wk.get(str(float(a))))
+        if ka is None or not math.isclose(quality_of(ka), best, abs_tol=1e-12):
+            raise RulerViolation(f"alpha do WiSE {a} nao e o argmax do kappa ORIG-val {wk}")
+        if not math.isclose(float(ka), float(k), abs_tol=1e-12):
+            raise RulerViolation(f"kappa final {k} != kappa ORIG-val do alpha escolhido {ka}")
diff --git a/ga_search/hmodehb/hevaluate.py b/ga_search/hmodehb/hevaluate.py
new file mode 100644
index 0000000..7ae6304
--- /dev/null
+++ b/ga_search/hmodehb/hevaluate.py
@@ -0,0 +1,91 @@
+"""Avaliador do H-MODEHB: subclasse de ``run_search.Evaluator`` com a fitness v2.
+
+Reusa todo o pipeline historico (SPiFiL -> AE local -> SSL global LeJEPA+SIGReg -> WiSE -> perfil de
+custo -> checkpoint). Muda so a leitura da fitness:
+
+* ``_svm_score`` chama ``supervised_fitness.svm_fitness`` com a regua ORIG fixa (C=100, scaler none,
+  whiten none, kappa_weight 1.0) sobre ``head(encoder(x))``, recusando embedding < 1280;
+* o resultado vira v2 (``fitness_v2.finalize``): quality = kappa ORIG sem multiplicador de colapso,
+  diagnosticos em ``aux``; embedding/loss nao finitos -> ``NonFiniteFitness`` (controller: reason=nan);
+* ``result.json`` leva ``cand_key``, ``fitness_sig``, ``config_sha`` e ``checkpoint_sha256`` (adocao
+  no resume).
+
+O split de teste nunca e carregado (``progressive_data.load_data`` devolve so treino/validacao).
+"""
+from __future__ import annotations
+
+from ga_search.hmodehb import bk as BK
+from ga_search.hmodehb import fitness_v2 as FV
+from ga_search.hmodehb import integrity as I
+from ga_search.modehb import run_search as RS
+
+
+class EmbedDimError(FV.FitnessConfigError):
+    """Cabeca com embedding < 1280 (proibido pela decisao do usuario de 17/11)."""
+
+
+class HEvaluator(RS.Evaluator):
+    def __init__(self, cfg, out_dir):
+        self.sv2 = FV.validate_eval(cfg.get("eval") or {})
+        if (cfg.get("data") or {}).get("val_max_samples") is not None:
+            raise FV.FitnessConfigError("fitness v2 usa a validacao INTEIRA: data.val_max_samples deve ser null")
+        super().__init__(cfg, out_dir)
+        self.fitness_spec = FV.spec(self.sv2, val_sha256=self.split_hash, n_val=int(len(self.val_y)),
+                                    dataset=self.dataset, split=(cfg.get("data") or {}).get("split"))
+        self.fitness_sig = FV.signature(self.fitness_spec)
+        self._fit_sv, self._readouts, self._svm_stamps = None, [], []
+
+    # ---- regua ORIG (em TODA leitura que decide: alpha do WiSE e kappa final)
+    def _svm_features(self, encoder, head):
+        """Sempre head(encoder(x)), tta 1: nunca cov_head, qualquer que seja o config."""
+        self.__dict__.setdefault("_readouts", []).append("head")
+        tr = self._embed(encoder, head, self.svm_train_x, tta=1, readout="head").numpy()
+        va = self._embed(encoder, head, self.val_x, tta=1, readout="head").numpy()
+        return tr, va
+
+    def _embed_cov(self, encoder, head, extra=None):
+        self.__dict__.setdefault("_readouts", []).append("cov_head")      # so diagnostico; se alimentar uma decisao, o carimbo acusa
+        return super()._embed_cov(encoder, head, extra)
+
+    def _svm_score(self, tr, va):
+        from ga_search.modehb.supervised_fitness import svm_fitness
+        d = int(va.reshape(len(va), -1).shape[1])
+        if d < BK.MIN_EMBED_DIM:
+            raise EmbedDimError(f"embedding de dimensao {d} < {BK.MIN_EMBED_DIM}")
+        kw = {"C": FV.REQUIRED["C"], "scaler": "none", "whiten": "none", "kappa_weight": 1.0,
+              "max_train": self.sv2["max_train"]}
+        if self.sv2.get("gram_reduce"):
+            kw["gram_reduce"] = True
+        self.__dict__.setdefault("_svm_stamps", []).append({k: kw[k] for k in ("C", "scaler", "whiten", "kappa_weight", "max_train")})
+        return svm_fitness(tr, self.svm_train_y.numpy(), va, self.val_y.numpy(), seed=self.seed, **kw)
+
+    def _svm_quality(self, encoder, head):
+        sv = super()._svm_quality(encoder, head)
+        self._fit_sv = sv
+        return sv
+
+    def _wise_select(self, encoder, head, anchor, trained, alphas, run):
+        out = super()._wise_select(encoder, head, anchor, trained, alphas, run)
+        self._fit_sv = out["sv"]
+        return out
+
+    # ---- uma avaliacao
+    def _evaluate(self, genome, fidelity, ctx, cand_dir, run):
+        if int(genome.get("embed_dim", 0)) < BK.MIN_EMBED_DIM:
+            raise EmbedDimError(f"genoma com embed_dim={genome.get('embed_dim')} < {BK.MIN_EMBED_DIM}")
+        if ctx.get("fitness_sig") not in (None, self.fitness_sig):
+            raise FV.FitnessSigMismatch(f"controller {ctx.get('fitness_sig')} != avaliador {self.fitness_sig}")
+        self._fit_sv, self._readouts, self._svm_stamps = None, [], []
+        base = super()._evaluate(genome, fidelity, ctx, cand_dir, run)
+        sv = self._fit_sv or {}
+        res = FV.finalize(base, kappa=base.get("fitness_kappa"), nonfinite=bool(sv.get("nonfinite")))
+        # carimbo de cada leitura que decidiu (readouts x kwargs do SVM; solver/tta fixos no _svm_features)
+        res["decision_rulers"] = sorted({FV.ruler_sig({"readout": r, "tta": 1, "solver": "libsvm", **st})
+                                         for r in set(self._readouts) for st in self._svm_stamps})
+        res["n_svm_decisions"] = len(self._svm_stamps)
+        res.update(cand_key=ctx.get("cand_key"), lineage_key=ctx.get("lineage_key"),
+                   fitness_sig=self.fitness_sig, config_sha=ctx.get("config_sha"),
+                   checkpoint_sha256=I.file_sha256(res.get("checkpoint")),
+                   embed_dim=int(genome["embed_dim"]), bk=BK.bk_of(res.get("params")),
+                   params_counted="encoder+head (decoders/projetores fora)")
+        return res
diff --git a/ga_search/hmodehb/hsearch.py b/ga_search/hmodehb/hsearch.py
new file mode 100644
index 0000000..ab30256
--- /dev/null
+++ b/ga_search/hmodehb/hsearch.py
@@ -0,0 +1,319 @@
+"""Controller do H-MODEHB: subclasse de ``modehb.MODEHB`` com a camada de integridade.
+
+O que muda em relacao ao MODEHB (que continua intocado e e reusado por heranca):
+
+* faixas B0-B4 fixas e teto duro de 5,5M (``bk.py``); pre-checagem estrutural antes de gastar GPU;
+* fitness v2 (``fitness_v2.py``): F = [1 - kappa_val_ORIG, MACs log-normalizados]; ``fitness_sig``
+  gravada no estado e em cada job; o resume recusa outra regua (``FitnessSigMismatch``);
+* ``cand_key`` = genoma + origem dos pesos (ancestral + sha256 do checkpoint) + fidelidade +
+  assinatura. O cache e o resume de promocao usam essa chave (``lineage_key`` sem a fidelidade),
+  nunca so o ``arch_hash``: um filho herdado com a mesma arquitetura de um candidato ja avaliado nao
+  recebe o resultado em cache (a heranca nao e descartada);
+* ``config_sha`` do config completo e ``config_full`` no estado; deriva no resume -> ``ConfigDrift``
+  (salvo ``allow_drift``, registrado em ``drift_log``);
+* trava ``flock`` contra dois controladores no mesmo diretorio;
+* adocao, no resume, de um resultado ja gravado (``hjobs/<job>.json`` do controller ou
+  ``candidates/<id>/f<F>/result.json`` do avaliador) com a mesma ``cand_key`` e checkpoint integro;
+* OOM com tentativas parametrizadas e motivo de falha explicito (oom, nan, missing_ancestor, ...);
+* ids ``h4-<braco>-c#####`` e ``kind = h4_<braco>`` no estado (monitor_report).
+"""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from typing import Callable, Iterable, Optional
+
+from ga_search.hmodehb import bk as BK
+from ga_search.hmodehb import fitness_v2 as FV
+from ga_search.hmodehb import integrity as I
+from ga_search.modehb import modehb as M
+
+STATE_VERSION = 1
+
+
+class HMODEHB(M.MODEHB):
+    def __init__(self, config: dict, evaluate: Callable, output_dir, *, arm: str, fitness_spec: dict,
+                 full_config: dict, allow_drift: Iterable[str] = (), oom_retries: int = 4,
+                 oom_sleep_s: float = 180.0, lock: Optional[I.ControllerLock] = None, logger=None,
+                 spifil_repair: Optional[Callable] = None, param_fn: Optional[Callable] = None):
+        cfg = dict(config or {})
+        if (cfg.get("pnas_cs") or {}).get("enabled") or cfg.get("pnas_cs"):
+            raise NotImplementedError("braco C (PNAS-CS) ainda nao roda no H-MODEHB: os niveis do pnas_cs.py "
+                                      "(pontos medios geometricos, cap x1,05) nao sao as faixas B0-B4")
+        if cfg.get("use_latency"):
+            raise FV.FitnessConfigError("fitness v2: latencia nao e objetivo (use_latency: false)")
+        ob = cfg.get("objective_bounds") or {}
+        want = {"flops_lo": FV.FLOPS_BOUNDS[0], "flops_hi": FV.FLOPS_BOUNDS[1]}
+        if any(float(ob[k]) != v for k, v in want.items() if k in ob) or set(ob) - set(want):
+            raise FV.FitnessConfigError(f"objective_bounds deve ser {want}, veio {ob}")
+        cfg["objective_bounds"] = want
+        cfg["stratified"] = BK.stratified_block(cfg.get("stratified"))
+        super().__init__(cfg, evaluate, output_dir, logger=logger, spifil_repair=spifil_repair, param_fn=param_fn)
+        BK.check_strat(self.strat)
+        self.arm = I.check_arm(arm)
+        self.kind = f"h4_{self.arm}"
+        self.fitness_spec = dict(fitness_spec)
+        self.fitness_sig = FV.signature(self.fitness_spec)
+        self.full_config = I._plain(full_config)
+        self.config_sha = I.config_sha(self.full_config)
+        self.allow_drift = tuple(allow_drift or ())
+        self.oom_retries, self.oom_sleep_s = int(oom_retries), float(oom_sleep_s)
+        self._lock = lock
+        self._carry = {}
+
+    # ---- estado
+    def _fresh_state(self):
+        st = super()._fresh_state()
+        st.update({
+            "hmodehb_version": STATE_VERSION, "arm": self.arm, "kind": self.kind,
+            "id_prefix": f"{I.ID_PREFIX}-{self.arm}-",
+            "fitness_sig": self.fitness_sig, "fitness_spec": self.fitness_spec,
+            "config_sha": self.config_sha, "config_full": self.full_config,
+            "config_sha_initial": self._carry.get("config_sha_initial", self.config_sha),
+            "drift_log": list(self._carry.get("drift_log", [])),
+            "created": self._carry.get("created") or time.time(),
+            "bk_bands": BK.bands_dict(), "param_cap": BK.HARD_CAP,
+            "oom": {"retries": self.oom_retries, "sleep_s": self.oom_sleep_s}})
+        return st
+
+    def _check_resume(self):
+        if not self.state_path.exists():
+            return
+        old = json.loads(self.state_path.read_text())
+        if old.get("fitness_sig") != self.fitness_sig:
+            raise FV.FitnessSigMismatch(
+                f"{self.state_path}: regua gravada {old.get('fitness_sig')} != atual {self.fitness_sig}. "
+                f"Uma busca nunca mistura reguas (ex.: C=0.1 x C=100, cov_head x head): use outro diretorio.")
+        if old.get("arm") != self.arm:
+            raise I.ConfigDrift(f"{self.state_path}: braco gravado {old.get('arm')} != {self.arm}")
+        drift = I.check_drift(old, self.full_config, self.allow_drift)
+        self._carry = {"drift_log": list(old.get("drift_log") or []) + ([drift] if drift else []),
+                       "config_sha_initial": old.get("config_sha_initial", old.get("config_sha")),
+                       "created": old.get("created")}
+
+    def run(self, resume: bool = False) -> dict:
+        own = self._lock is None
+        lock = I.ControllerLock(self.out).acquire() if own else self._lock
+        try:
+            self._carry = {}
+            if self.state_path.exists() and resume:
+                self._check_resume()
+            return super().run(resume=resume)
+        finally:
+            if own:
+                lock.release()
+
+    # ---- ids
+    def _new_id(self):
+        self.state["n_candidates"] += 1
+        return I.cand_id(self.arm, self.state["n_candidates"])
+
+    # ---- identidade do candidato
+    def _weight_origin(self, genome, cand_id, role, inherit):
+        """Origem dos pesos: a do candidato (promocao/extensao/gemea seguinte) ou uma nova."""
+        if cand_id is not None:
+            for j in self.state["jobs"]:
+                if j["cand_id"] == cand_id and j["role"] == role and j.get("weight_origin") is not None:
+                    return j["weight_origin"]
+        if inherit and role == "search":
+            jobs, pj, sha = self.state["jobs"], inherit.get("parent_job"), None
+            if pj is not None and 0 <= int(pj) < len(jobs):
+                sha = (jobs[int(pj)].get("result") or {}).get("checkpoint_sha256")
+            if sha is None:
+                sha = I.file_sha256(inherit.get("checkpoint"))
+            return {"kind": "inherit", "parent_cand_id": inherit.get("parent_cand_id"),
+                    "parent_fidelity": inherit.get("parent_fidelity"), "parent_ckpt_sha256": sha,
+                    "n_blocks": inherit.get("n_blocks"), "layer_map": inherit.get("layer_map")}
+        if genome.get("external"):
+            return {"kind": "external", "external": genome["external"]}
+        return {"kind": "scratch", "init": genome.get("init")}
+
+    def _keys(self, genome, fid, cand_id, role, inherit):
+        origin = self._weight_origin(genome, cand_id, role, inherit)
+        lkey = I.lineage_key(M.canonical(genome), genome.get("seed"), origin, self.fitness_sig)
+        return origin, lkey, I.cand_key(lkey, fid)
+
+    # ---- avaliacao (mesma estrutura de MODEHB._evaluate; cache/resume por cand_key/lineage_key)
+    def _evaluate(self, genome, fid, *, parent_id, generation, rung, cand_id=None, vector=None,
+                  role="search", twin_of=None, twin_source=None, inherit=None, extra_ctx=None):
+        genome = M.repair(genome, **self.repair_kw)
+        origin, lkey, ckey = self._keys(genome, fid, cand_id, role, inherit)
+        jobs = self.state["jobs"]
+        cached = [j for j in jobs if j.get("cand_key") == ckey and j["role"] == role]
+        lower = [j for j in jobs if j.get("lineage_key") == lkey and j["role"] == role and j["fidelity"] < fid
+                 and j["status"] == "ok" and j["result"].get("checkpoint")]
+        resume = max(lower, key=lambda j: j["fidelity"]) if lower else None
+        if cand_id is None:
+            cand_id = resume["cand_id"] if resume else (cached[0]["cand_id"] if cached else self._new_id())
+        ctx = {"cand_id": cand_id, "parent_id": parent_id, "generation": generation, "bracket": generation,
+               "rung": rung, "role": role, "twin_of": twin_of, "resume": resume, "twin_source": twin_source,
+               "front_rank": lambda result, _f=fid: self.rank_of(result, _f),
+               "cand_key": ckey, "lineage_key": lkey, "fitness_sig": self.fitness_sig,
+               "config_sha": self.config_sha, "job_index": len(jobs), "weight_origin": origin, "arm": self.arm}
+        if extra_ctx:
+            ctx.update(extra_ctx)
+        if inherit and resume is None and not cached and role == "search":
+            ctx["inherit"] = inherit
+        p_est = int(self.param_fn(genome))
+        if cached:
+            result = {k: v for k, v in cached[0]["result"].items()}
+            result["cached_from"] = cached[0]["job"]
+            cost_free = True
+        elif p_est > BK.HARD_CAP:         # teto duro: nunca gasta GPU num genoma acima de 5,5M
+            result = {"status": "failed", "infeasible": "param_cap", "reason": "param_cap",
+                      "error": f"params estimados {p_est} > teto {BK.HARD_CAP}"}
+            cost_free = True
+        else:
+            result = self._call(genome, fid, ctx)
+            cost_free = False
+        FV.check_decisions(result, self.fitness_spec)   # toda decisao pela regua gravada, senao para tudo
+        from ga_search.modehb import strata as S
+        p_meas = result.get("params") if result.get("status", "ok") == "ok" else None
+        stratum = S.stratum_of(p_meas if p_meas is not None else p_est, self.strat)
+        if result.get("status", "ok") == "ok" and p_meas is not None and int(p_meas) > BK.HARD_CAP:
+            result = {**result, "status": "failed", "infeasible": "param_cap", "reason": "param_cap",
+                      "error": f"params {p_meas} > teto {BK.HARD_CAP}"}
+        F = FV.objectives(result)
+        rec = {"job": len(jobs), "cand_id": cand_id, "parent_id": parent_id,
+               "generation": generation, "rung": rung, "fidelity": fid, "role": role, "twin_of": twin_of,
+               "genome": genome, "arch_hash": M.arch_hash(genome),
+               "twin_key": M.arch_hash(genome, include_init=False),
+               "vector": list(vector) if vector is not None else self._encode(genome).tolist(),
+               "status": result.get("status", "ok"), "F": F, "result": result,
+               "resumed_from": resume["job"] if resume else None, "cached": cost_free,
+               "time": time.time(), "cand_key": ckey, "lineage_key": lkey, "weight_origin": origin,
+               "fitness_sig": self.fitness_sig, "config_sha": self.config_sha,
+               "stratum": stratum, "bk": stratum, "params_est": p_est,
+               **({"inherit": {k: v for k, v in ctx["inherit"].items() if k != "effective_specs"}}
+                  if ctx.get("inherit") else {})}
+        jobs.append(rec)
+        if not cost_free:
+            self.state["gpu_hours"] += float(result.get("gpu_hours", 0.0) or 0.0)
+        self._save()
+        if role == "search" and genome["init"] == "spifil" and fid == self.fidelities[-1] and rec["status"] == "ok" \
+                and self.random_baseline:
+            self._evaluate_twin(rec)
+        return rec
+
+    def _evaluate_twin(self, rec):
+        """Gemea random ao longo do caminho de fidelidades DESTE candidato (cand_id, nao arch_hash)."""
+        twin = M.make_twin(rec["genome"])
+        mine = [j for j in self.state["jobs"] if j["cand_id"] == rec["cand_id"] and j["role"] == "search"]
+        path = sorted({j["fidelity"] for j in mine if j["status"] == "ok"})
+        twin_id = None
+        for f in path:
+            done = [j for j in self.state["jobs"] if j["role"] == "twin" and j["twin_of"] == rec["cand_id"]
+                    and j["fidelity"] == f]
+            if done:
+                twin_id = done[0]["cand_id"]
+                continue
+            src = next(j for j in mine if j["fidelity"] == f)
+            t = self._evaluate(twin, f, parent_id=rec["cand_id"], generation=rec["generation"],
+                               rung=src["rung"], cand_id=twin_id, role="twin",
+                               twin_of=rec["cand_id"], twin_source=src)
+            twin_id = t["cand_id"]
+
+    # ---- chamada do avaliador: replay, adocao, OOM, motivo de falha
+    def _hjob_path(self, k):
+        return self.out / "hjobs" / f"{int(k):06d}.json"
+
+    def _adopt(self, k, ctx, fid):
+        """Resultado ja gravado deste job (crash entre a escrita e o _save) ou None."""
+        srcs = [(self._hjob_path(k), lambda d: (d or {}).get("result")),
+                (self.out / "candidates" / ctx["cand_id"] / f"f{int(fid)}" / "result.json", lambda d: d)]
+        for path, get in srcs:
+            res = get(I.read_json(path)) if path.exists() else None
+            if res is None:
+                continue
+            why = I.adoptable(res, ckey=ctx["cand_key"], fitness_sig=self.fitness_sig)
+            if why is None:
+                res = dict(res)
+                res["adopted"] = {"from": str(path), "job": int(k), "time": time.time()}
+                print(f"[hmodehb] job {k} ({ctx['cand_id']}@{fid:g}) adotado de {path} (sem re-treino)", flush=True)
+                return res
+            print(f"[hmodehb] job {k}: {path} nao adotado ({why})", flush=True)
+        return None
+
+    def _call(self, genome, fid, ctx):
+        k = len(self.state["jobs"])
+        if k < len(self._replay):
+            old = self._replay[k]
+            if old["arch_hash"] != M.arch_hash(genome) or float(old["fidelity"]) != float(fid) \
+                    or old["role"] != ctx["role"] or old.get("cand_key") != ctx["cand_key"] \
+                    or old.get("fitness_sig") != self.fitness_sig:
+                raise M.ReplayMismatch(
+                    f"job {k}: gravado {old['arch_hash']}@{old['fidelity']} key={old.get('cand_key')} "
+                    f"sig={old.get('fitness_sig')} vs {M.arch_hash(genome)}@{fid} key={ctx['cand_key']} "
+                    f"sig={self.fitness_sig}")
+            return old["result"]
+        result = self._adopt(k, ctx, fid)
+        if result is None:
+            I.atomic_write_json(self.out / "pending_job.json",
+                                {"job": k, "cand_id": ctx["cand_id"], "cand_key": ctx["cand_key"], "fidelity": fid,
+                                 "role": ctx["role"], "config_sha": self.config_sha,
+                                 "fitness_sig": self.fitness_sig, "time": time.time()})
+            result = self._run_with_retries(genome, fid, ctx, k)
+        FV.check_decisions(result, self.fitness_spec)       # antes de gravar qualquer coisa
+        result.setdefault("status", "ok")
+        result.setdefault("cand_key", ctx["cand_key"])
+        result.setdefault("fitness_sig", self.fitness_sig)
+        result.setdefault("config_sha", self.config_sha)
+        if result["status"] == "ok" and result.get("checkpoint") and not result.get("checkpoint_sha256"):
+            result["checkpoint_sha256"] = I.file_sha256(result["checkpoint"])
+        I.atomic_write_json(self._hjob_path(k), {"job": k, "cand_id": ctx["cand_id"], "cand_key": ctx["cand_key"],
+                                                 "fidelity": fid, "role": ctx["role"], "result": result})
+        return result
+
+    def _run_with_retries(self, genome, fid, ctx, k):
+        attempt = 0
+        while True:
+            try:
+                res = dict(self.evaluate_fn(genome, fid, ctx))
+                if attempt:
+                    res["oom_retries"] = attempt
+                return res
+            except Exception as exc:       # falha de avaliacao = candidato inviavel, nao crash
+                if M._fatal_cuda(exc):        # contexto CUDA envenenado: sem registro, o resume refaz
+                    raise
+                if isinstance(exc, FV.FitnessSigMismatch):   # regua errada (inclui RulerViolation): fatal
+                    raise
+                if M._is_oom(exc) and attempt < self.oom_retries:
+                    attempt += 1
+                    print(f"[hmodehb] OOM no job {k}; tentativa {attempt}/{self.oom_retries} em {self.oom_sleep_s:g}s",
+                          flush=True)
+                    time.sleep(self.oom_sleep_s)
+                    continue
+                if M._is_oom(exc):
+                    reason = "oom"
+                elif isinstance(exc, FV.NonFiniteFitness):
+                    reason = "nan"
+                elif type(exc).__name__ == "EmbedDimError":
+                    reason = "embed_dim"
+                elif isinstance(exc, FV.FitnessConfigError):
+                    reason = "fitness_config"
+                elif isinstance(exc, FileNotFoundError) and ctx.get("inherit"):
+                    reason = "missing_ancestor"
+                else:
+                    reason = "error"
+                res = {"status": "failed", "reason": reason, "error": f"{type(exc).__name__}: {exc}"}
+                if attempt:
+                    res["oom_retries"] = attempt
+                return res
+
+    # ---- exportacao: melhor por B_k (validacao, fidelidade maxima)
+    def best_by_bk(self, fidelity=None) -> dict:
+        fid = float(fidelity if fidelity is not None else self.fidelities[-1])
+        out = {}
+        for j in self.state["jobs"]:
+            if j["role"] != "search" or j["status"] != "ok" or float(j["fidelity"]) != fid or not j.get("bk"):
+                continue
+            cur = out.get(j["bk"])
+            key = (j["F"][0], j["F"][1])
+            if cur is None or key < (cur["F"][0], cur["F"][1]):
+                out[j["bk"]] = {"cand_id": j["cand_id"], "cand_key": j["cand_key"], "F": j["F"],
+                                "kappa_val_orig": j["result"].get("kappa_val_orig", j["result"].get("fitness_kappa")),
+                                "params": j["result"].get("params"), "flops": j["result"].get("flops"),
+                                "checkpoint": j["result"].get("checkpoint"),
+                                "checkpoint_sha256": j["result"].get("checkpoint_sha256"), "fidelity": fid}
+        return {"fitness_sig": self.fitness_sig, "fidelity": fid, "best": out}
diff --git a/ga_search/hmodehb/integrity.py b/ga_search/hmodehb/integrity.py
new file mode 100644
index 0000000..b68f6ee
--- /dev/null
+++ b/ga_search/hmodehb/integrity.py
@@ -0,0 +1,210 @@
+"""Integridade do H-MODEHB (desenho secao 7): hash de config + deriva, trava de controlador,
+identidade de candidato (cand_key) e adocao de resultados ja gravados no resume.
+
+Nada aqui importa torch: tudo testavel em CPU e sem GPU.
+"""
+from __future__ import annotations
+
+import datetime as _dt
+import fcntl
+import hashlib
+import json
+import os
+import socket
+import time
+from pathlib import Path
+from typing import Iterable, Optional
+
+# chaves fora do hash de config: nao mudam o experimento (modo do W&B, dispositivo)
+DRIFT_EXCLUDE = ("wandb.mode", "device", "hmodehb.allow_drift")
+ARMS = ("A", "B", "C", "D0", "D", "E")
+ID_PREFIX = "h4"
+
+
+# ────────────────────────────────────────────────────────────────── config hash / deriva
+class ConfigDrift(RuntimeError):
+    """O config atual difere do gravado no search_state.json (resume com outra receita)."""
+
+
+def _plain(x):
+    return json.loads(json.dumps(x, sort_keys=True, default=str))
+
+
+def flatten(d, prefix: str = "") -> dict:
+    out = {}
+    if isinstance(d, dict):
+        if not d and prefix:
+            out[prefix] = {}
+        for k in sorted(d, key=str):
+            out.update(flatten(d[k], f"{prefix}.{k}" if prefix else str(k)))
+    else:
+        out[prefix] = d
+    return out
+
+
+def _strip(cfg: dict, exclude: Iterable[str] = DRIFT_EXCLUDE) -> dict:
+    flat = flatten(_plain(cfg))
+    ex = tuple(exclude)
+    return {k: v for k, v in flat.items() if not any(k == e or k.startswith(e + ".") for e in ex)}
+
+
+def config_sha(cfg: dict, exclude: Iterable[str] = DRIFT_EXCLUDE) -> str:
+    """sha256 do config completo (search + eval + train + data + ...) canonico (chaves ordenadas)."""
+    blob = json.dumps(_strip(cfg, exclude), sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def config_diff(old: dict, new: dict, exclude: Iterable[str] = DRIFT_EXCLUDE) -> list:
+    a, b = _strip(old, exclude), _strip(new, exclude)
+    return sorted(k for k in set(a) | set(b) if a.get(k, "<ausente>") != b.get(k, "<ausente>"))
+
+
+def _allowed(key: str, allow: Iterable[str]) -> bool:
+    return any(key == a or key.startswith(a + ".") for a in allow)
+
+
+def check_drift(old_state: dict, cfg: dict, allow: Iterable[str] = ()) -> Optional[dict]:
+    """None se nao ha deriva; dict de registro se a deriva e toda permitida; ``ConfigDrift`` senao."""
+    old_cfg = old_state.get("config_full")
+    old_sha = old_state.get("config_sha")
+    if old_cfg is None or old_sha is None:
+        raise ConfigDrift("search_state.json sem config_full/config_sha: nao e um estado H-MODEHB")
+    new_sha = config_sha(cfg)
+    if new_sha == old_sha:
+        return None
+    keys = config_diff(old_cfg, cfg)
+    allow = tuple(allow or ())
+    bad = [k for k in keys if not _allowed(k, allow)]
+    if bad:
+        a, b = _strip(old_cfg), _strip(cfg)
+        show = {k: [a.get(k, "<ausente>"), b.get(k, "<ausente>")] for k in bad[:20]}
+        raise ConfigDrift(f"config mudou desde o inicio da busca ({len(bad)} chave(s) nao permitidas): {show}. "
+                          f"Use --allow-drift <chave> so se a mudanca for intencional (fica no drift_log).")
+    return {"time": time.time(), "keys": keys, "old_sha": old_sha, "new_sha": new_sha, "allowed": list(allow)}
+
+
+# ────────────────────────────────────────────────────────────────── trava de controlador
+class ControllerLocked(RuntimeError):
+    """Outro controlador ja segura o lock deste search_state."""
+
+
+class ControllerLock:
+    """``fcntl.flock`` exclusivo e nao bloqueante em ``<out>/controller.lock``.
+
+    O lock e do kernel (some quando o processo morre, inclusive kill -9): nunca fica preso. O arquivo
+    guarda pid/host/inicio do dono atual so para diagnostico."""
+
+    def __init__(self, out_dir, name: str = "controller.lock"):
+        self.path = Path(out_dir) / name
+        self.fd = None
+
+    def acquire(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            try:
+                owner = os.pread(fd, 4096, 0).decode(errors="replace").strip()
+            finally:
+                os.close(fd)
+            raise ControllerLocked(f"{self.path} ja esta travado por outro controlador: {owner or '?'}")
+        info = {"pid": os.getpid(), "host": socket.gethostname(),
+                "start": _dt.datetime.now().isoformat(timespec="seconds")}
+        os.ftruncate(fd, 0)
+        os.pwrite(fd, json.dumps(info).encode(), 0)
+        os.fsync(fd)
+        self.fd = fd
+        return self
+
+    def release(self):
+        if self.fd is not None:
+            try:
+                fcntl.flock(self.fd, fcntl.LOCK_UN)
+            finally:
+                os.close(self.fd)
+                self.fd = None
+
+    def __enter__(self):
+        return self.acquire()
+
+    def __exit__(self, *exc):
+        self.release()
+        return False
+
+
+# ────────────────────────────────────────────────────────────────── ids e chaves
+def check_arm(arm: str) -> str:
+    if arm not in ARMS:
+        raise ValueError(f"braco {arm!r} invalido; use um de {ARMS}")
+    return arm
+
+
+def cand_id(arm: str, n: int) -> str:
+    return f"{ID_PREFIX}-{check_arm(arm)}-c{int(n):05d}"
+
+
+def _h(obj) -> str:
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, separators=(",", ":"), default=str).encode()).hexdigest()[:20]
+
+
+def lineage_key(canonical_genome: dict, seed, origin: dict, fitness_sig: str) -> str:
+    """Identidade do candidato sem a fidelidade: genoma efetivo + seed + origem dos pesos + regua.
+    Uma promocao (mesmo candidato, fidelidade maior) mantem a lineage_key."""
+    return _h({"g": canonical_genome, "seed": seed, "origin": origin, "fsig": fitness_sig})
+
+
+def cand_key(lkey: str, fidelity) -> str:
+    """Identidade de um JOB: lineage_key + fidelidade (= genoma + origem + fidelidade + assinatura)."""
+    return _h({"l": lkey, "fid": float(fidelity)})
+
+
+def file_sha256(path, chunk: int = 1 << 20) -> Optional[str]:
+    p = Path(path) if path else None
+    if p is None or not p.is_file():
+        return None
+    h = hashlib.sha256()
+    with p.open("rb") as f:
+        for b in iter(lambda: f.read(chunk), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+# ────────────────────────────────────────────────────────────────── adocao no resume
+def atomic_write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + f".tmp{os.getpid()}")
+    with tmp.open("w") as f:
+        f.write(json.dumps(value, indent=1, sort_keys=True, default=str))
+        f.flush()
+        os.fsync(f.fileno())
+    tmp.replace(path)
+
+
+def read_json(path) -> Optional[dict]:
+    try:
+        v = json.loads(Path(path).read_text())
+    except Exception:          # ausente, parcial (kill durante a escrita) ou corrompido -> nao adota
+        return None
+    return v if isinstance(v, dict) else None
+
+
+def adoptable(result: Optional[dict], *, ckey: str, fitness_sig: str) -> Optional[str]:
+    """Motivo para NAO adotar (None = adotavel). Exige mesma cand_key e regua; se ok, checkpoint
+    presente com o mesmo sha256 gravado (nunca adota checkpoint parcial/trocado)."""
+    if result is None:
+        return "sem resultado"
+    if result.get("cand_key") != ckey:
+        return f"cand_key {result.get('cand_key')} != {ckey}"
+    if result.get("fitness_sig") != fitness_sig:
+        return f"fitness_sig {result.get('fitness_sig')} != {fitness_sig}"
+    if result.get("status", "ok") == "ok":
+        ck, sha = result.get("checkpoint"), result.get("checkpoint_sha256")
+        if not ck or not sha:
+            return "resultado ok sem checkpoint/sha256"
+        got = file_sha256(ck)
+        if got != sha:
+            return f"checkpoint {ck} ausente ou com sha256 diferente"
+    return None
+
diff --git a/ga_search/hmodehb/run_hsearch.py b/ga_search/hmodehb/run_hsearch.py
