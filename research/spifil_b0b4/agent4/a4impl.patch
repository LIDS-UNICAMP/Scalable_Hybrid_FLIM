+    n_calls = len(ev.calls)
+    rec = s._evaluate(src["genome"], src["fidelity"], parent_id=src["cand_id"], generation=9, rung=0,
+                      inherit=inherit)
+    assert len(ev.calls) == n_calls + 1 and not rec["cached"]                  # treinou de verdade
