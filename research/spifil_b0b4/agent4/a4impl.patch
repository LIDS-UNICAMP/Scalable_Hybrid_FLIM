+    {"decision_rulers": [FV.ruler_sig({**H.SPEC, "readout": "cov_head"})]},           # WiSE/fitness por COV
+    {"decision_rulers": [FV.ruler_sig(H.SPEC), FV.ruler_sig({**H.SPEC, "scaler": "standard"})]},
+    {"decision_rulers": [FV.ruler_sig({**H.SPEC, "C": 0.1})]},
