+    svm_calls = []
+    real_svm = SF.svm_fitness
+
+    def spy(*a, **k):
+        svm_calls.append({"d": int(np.asarray(a[2]).reshape(len(a[2]), -1).shape[1]), **k})
+        return real_svm(*a, **k)
+    SF.svm_fitness = spy
+    try:
+        s = R.build(cfg, ev)
+        st = s.run()
+        R.write_outputs(s, st, Path(out))
