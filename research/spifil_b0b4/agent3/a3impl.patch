@@ -0,0 +1,192 @@
+"""Cada morfismo exato: erro de preservação <= 1e-5 (rel-L2) em eval(), CPU, fp32, no mapa e no embedding 1280."""
+import pytest
+import torch
+
+from _helpers import TOL, assert_exact, make_parent, small_spec, x_batch
+from ga_search.backbones.morphisms import (NotExactError, add_skip_zero, apply_ops, deepen_identity,
+                                           deepen_residual_zero, finalize, start, widen)
+from ga_search.backbones.spec import GrowthSpec, HeadSpec, LayerSpec
+
+X = x_batch()
+
+
+def L(c, **kw):
+    return LayerSpec(channels=c, **kw)
+
+
+# (nome, camadas do estágio, larguras novas {índice plano: largura}, kernels)
+WIDEN_CASES = [
+    ("conv_plain", [L(12), L(16, pool="max")], {0: 12, 1: 20, 2: 24}, {}),
+    ("conv_kernel_grow", [L(12), L(16, pool="max")], {1: 18, 2: 20}, {1: 5}),
+    ("batchnorm", [L(12, norm="batch"), L(16, norm="batch", pool="max")], {0: 10, 1: 18, 2: 22}, {}),
+    ("instance", [L(12, norm="instance"), L(16, pool="max")], {1: 14, 2: 20}, {}),
+    ("residual_identity", [L(8, residual="identity", norm="batch"), L(16, pool="max")], {0: 12, 1: 12, 2: 20}, {}),
+    ("residual_project", [L(12, residual="project", norm="batch"), L(16, residual="project", pool="max")],
+     {1: 15, 2: 21}, {}),
+    ("dwsep", [L(12, conv="dwsep", norm="batch"), L(16, conv="dwsep", pool="max")], {0: 11, 1: 16, 2: 24}, {}),
+    ("depthwise_cin_eq_cout", [L(12), L(12, conv="depthwise", norm="batch", pool="max")], {1: 18, 2: 18}, {}),
+    ("pointwise", [L(12, conv="pointwise"), L(16, pool="max")], {1: 13, 2: 20}, {}),
+    ("inception", [L(12, conv="inception", norm="batch"), L(16, conv="inception", pool="max")],
+     {0: 10, 1: 19, 2: 27}, {}),
+    ("zca_frozen", [L(12, norm="zca"), L(16, norm="batch_zca", pool="max")], {1: 18, 2: 22}, {}),
+    ("dbn_eval", [L(24, norm="dbn"), L(20, norm="batch_dbn", pool="max", dbn_group_size=8)], {1: 40, 2: 28}, {}),
+    ("acts", [L(12, activation="gelu"), L(12, activation="silu"), L(12, activation="selu"),
+              L(12, activation="leaky_relu"), L(16, activation="prelu", pool="avg")], {1: 14, 2: 15, 3: 16, 4: 17, 5: 18}, {}),
+    ("gated_skip_widen", [L(8, residual="gated"), L(16, pool="max")], {0: 10, 1: 10, 2: 18}, {}),
+]
+
+
+@pytest.mark.parametrize("name,layers,widths,kernels", WIDEN_CASES, ids=[c[0] for c in WIDEN_CASES])
+def test_widen_exact(name, layers, widths, kernels):
+    spec = small_spec(layers)
+    parent = make_parent(spec, seed=1, x=X)
+    if name == "gated_skip_widen":
+        with torch.no_grad():
+            parent.blocks[1].skip.gate.fill_(0.7)          # skip já treinado (gate != 0)
+    res = widen(start(parent), widths, kernels=kernels, seed=5)
+    g = finalize(res, X)
+    assert_exact(g)
+    ops = [o.op for o in g.operations]
+    assert "widen" in ops
+    assert ("head_widen" in ops) == (len(parent.blocks) - 1 in widths and
+                                     widths[len(parent.blocks) - 1] != parent.spec.layers()[-1].channels)
+    # todos os elementos do pai foram herdados (widen não corta)
+    assert g.inheritance["totals"]["inherited"] == sum(p.numel() for p in parent.parameters())
+    assert g.inheritance["totals"]["new"] == sum(p.numel() for p in res.child.parameters()) - \
+        sum(p.numel() for p in parent.parameters())
+    if name in ("zca_frozen", "dbn_eval"):
+        assert any("congelado" in o.condition for o in g.operations), [o.condition for o in g.operations]
+
+
+@pytest.mark.parametrize("pooling,proj,bn", [("gap", "full", False), ("gem", "full", False),
+                                             ("gem_learn", "full", False), ("meanstd", "full", False),
+                                             ("moments", "full", False), ("combo", "full", False),
+                                             ("gem", "full", True), ("meanstd", "lowrank", False),
+                                             ("gem", "lowrank", False)])
+def test_head_widen_exact_any_pooling(pooling, proj, bn):
+    head = HeadSpec(embed_dim=1280, pooling=pooling, proj=proj, rank=24 if proj == "lowrank" else None, bn=bn)
+    spec = small_spec([L(12), L(16, pool="max")], head=head)
+    parent = make_parent(spec, seed=2, x=X)
+    if bn:
+        with torch.no_grad():
+            hb = parent.head.proj[1]
+            hb.running_mean.normal_(0, 0.1)
+            hb.running_var.uniform_(0.5, 1.5)
+    res = widen(start(parent), {2: 30}, seed=3)
+    g = finalize(res, X)
+    assert_exact(g)
+    assert g.inheritance["head"] == "inherit_zero_cols"
+    hd = g.inheritance["head_detail"]
+    assert hd["n_new_elements"] == (30 - 16) * (24 if proj == "lowrank" else res.child.head.width)
+    assert res.child.head.out_dim == 1280 if proj == "full" else res.child.head.head.out_dim == 1280
+
+
+@pytest.mark.parametrize("norm", ["none", "batch"])
+@pytest.mark.parametrize("at", [1, 2, 3])
+def test_deepen_identity_exact(norm, at):
+    spec = small_spec([L(12), L(16, pool="max")])
+    parent = make_parent(spec, seed=3)
+    res = deepen_identity(start(parent), at, norm=norm)
+    g = finalize(res, X)
+    assert_exact(g)
+    rec = g.inheritance["per_layer"][at]
+    assert rec["origin"] == "fp_identity" and rec["n_inherited_elements"] == 0
+    assert len(res.child.blocks) == len(parent.blocks) + 1
+
+
+def test_deepen_identity_refuses_negative_input_and_declares_approx():
+    spec = small_spec([L(12, activation="gelu"), L(16, pool="max")])
+    parent = make_parent(spec, seed=4)
+    with pytest.raises(NotExactError):
+        deepen_identity(start(parent), 2)
+    res = deepen_identity(start(parent), 2, allow_approx=True)
+    g = finalize(res, X)
+    assert not g.preservation.exact_claimed
+    assert g.preservation.verdict in ("approx", "not_preserving")
+
+
+@pytest.mark.parametrize("act", ["silu", "gelu", "relu"])
+@pytest.mark.parametrize("conv,norm", [("conv", "none"), ("dwsep", "none"), ("conv", "batch"), ("inception", "none")])
+def test_deepen_residual_zero_exact(act, conv, norm):
+    # entrada com valores negativos (camada anterior GELU): residual zero é exato para qualquer entrada
+    spec = small_spec([L(12, activation="gelu"), L(16, pool="max")])
+    parent = make_parent(spec, seed=5)
+    res = deepen_residual_zero(start(parent), 2, act=act, conv=conv, norm=norm)
+    g = finalize(res, X)
+    assert_exact(g)
+    assert g.inheritance["per_layer"][2]["origin"] == "fp_residual_zero"
+
+
+@pytest.mark.parametrize("layers,layer,kind", [
+    ([L(8), L(16, pool="max")], 1, "gated"),          # cin == cout -> lambda = 0
+    ([L(12), L(16, pool="max")], 2, "project"),       # cin != cout -> 1x1 = 0
+    ([L(12, norm="batch"), L(16, pool="max")], 1, "project"),
+])
+def test_add_skip_zero_exact(layers, layer, kind):
+    parent = make_parent(small_spec(layers), seed=6, x=X)
+    res = add_skip_zero(start(parent), layer)
+    g = finalize(res, X)
+    assert_exact(g)
+    assert res.child.spec.layers()[layer].residual == kind
+    assert g.inheritance["per_layer"][layer]["skip_added"]
+
+
+def test_composite_chain_exact_and_masks():
+    """deepen_residual_zero + add_skip_zero + deepen_identity + widen + head_widen numa aresta."""
+    spec = small_spec([L(8, norm="batch"), L(12, conv="inception"), L(16, conv="dwsep", pool="max")])
+    parent = make_parent(spec, seed=7, x=X)
+    res = apply_ops(parent, [
+        {"op": "deepen_residual_zero", "at": 2, "act": "silu"},
+        {"op": "add_skip_zero", "layer": 1},
+        {"op": "deepen_identity", "at": 4},
+        {"op": "widen", "widths": {0: 10, 1: 10, 2: 10, 3: 17, 4: 17, 5: 24}, "seed": 9},
+    ])
+    g = finalize(res, X)
+    assert_exact(g)
+    assert [o.op for o in g.operations] == ["deepen_residual_zero", "add_skip_zero", "deepen_identity", "widen",
+                                            "head_widen"]
+    assert g.inheritance["totals"]["inherited"] == sum(p.numel() for p in parent.parameters())
+    # todo elemento herdado tem o mesmo valor que no pai (via mapas de canais) -> máscaras coerentes
+    for r in g.inheritance["per_layer"]:
+        if r["parent_index"] is not None:
+            assert r["n_inherited_elements"] == sum(p.numel() for p in parent.blocks[r["parent_index"]].parameters())
+    # o GrowthSpec serializa e volta igual
+    g2 = GrowthSpec.from_json(g.to_json())
+    assert g2.id == g.id and g2.content_hash() == g.content_hash()
+
+
+def test_layernorm_groupnorm_not_exact_declared():
+    spec = small_spec([L(12, norm="layer"), L(16, norm="group", pool="max")])
+    parent = make_parent(spec, seed=8)
+    with pytest.raises(NotExactError):
+        widen(start(parent), {1: 16})
+    res = widen(start(parent), {1: 16, 2: 24}, allow_approx=True)
+    g = finalize(res, X)
+    assert not g.preservation.exact_claimed
+    assert g.preservation.verdict in ("approx", "not_preserving")
+    assert any(not o.exact_claimed for o in g.operations)
+
+
+def test_dbn_group_split_refused():
+    # pai C=12, group_size 8 -> grupos [0,8),[8,12); filho C=20 alargado na camada ANTERIOR, mas a própria
+    # camada DBN herda canais 0..11 nas posições 0..11 e o grupo [8,16) do filho contém o grupo [8,12) inteiro.
+    spec = small_spec([L(12, norm="dbn", dbn_group_size=8), L(16, pool="max")])
+    parent = make_parent(spec, seed=9, x=X)
+    g = finalize(widen(start(parent), {1: 20}), X)
+    assert_exact(g)
+    # inception + DBN: canais novos intercalados por ramo partem os grupos -> recusado
+    spec2 = small_spec([L(16, conv="inception", norm="dbn", dbn_group_size=4), L(16, pool="max")])
+    parent2 = make_parent(spec2, seed=9, x=X)
+    with pytest.raises(NotExactError):
+        widen(start(parent2), {1: 20})
+
+
+def test_negative_control_detects_violation():
+    """Controle negativo: uma coluna 'nova' não-zero quebra a preservação e o veredito acusa 'violated'."""
+    parent = make_parent(small_spec([L(12), L(16, pool="max")]), seed=10)
+    res = widen(start(parent), {1: 20})
+    with torch.no_grad():
+        res.child.blocks[2].conv.weight[:, 12:] += 0.5        # colunas dos canais novos
+    g = finalize(res, X)
+    assert g.preservation.verdict == "violated"
+    assert g.preservation.emb_rel_l2 > TOL
