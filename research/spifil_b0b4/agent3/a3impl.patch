+++ b/tests/backbones/test_checkpoint.py
@@ -0,0 +1,102 @@
+"""Checkpoint autocontido: salvar, carregar (strict) e inferir; e inferir SÓ com torch, fora do repo."""
+import os
+import subprocess
+import sys
+
+import pytest
+import torch
+
+from _helpers import make_parent, small_spec, x_batch
+from ga_search.backbones.checkpoint import load_backbone, load_standalone, save_backbone, state_sha256
+from ga_search.backbones.family import REF_FLAT, flat_spec
+from ga_search.backbones.build import build_backbone
+from ga_search.backbones.morphisms import add_skip_zero, start, widen
+from ga_search.backbones.spec import HeadSpec, LayerSpec as L
+
+
+def _complex_model():
+    x = x_batch(4, 32)
+    spec = small_spec([L(12, norm="batch_zca"), L(12, conv="inception", norm="dbn", dbn_group_size=4),
+                       L(12, conv="dwsep", residual="identity"), L(16, residual="project", pool="max")],
+                      head=HeadSpec(pooling="moments", proj="lowrank", rank=24))
+    m = make_parent(spec, seed=11, x=x)
+    res = add_skip_zero(start(m), 1)
+    with torch.no_grad():
+        res.child.blocks[1].skip.weight.normal_(0, 0.1)
+    return res.child.eval(), x
+
+
+@pytest.mark.parametrize("kind", ["reference_b0", "complex"])
+def test_save_load_infer(tmp_path, kind):
+    if kind == "reference_b0":
+        m, x = build_backbone(flat_spec(REF_FLAT["B0"], head=HeadSpec(pooling="meanstd"))).eval(), x_batch(2, 64)
+    else:
+        m, x = _complex_model()
+    with torch.no_grad():
+        ref = m(x)
+    info = save_backbone(m, tmp_path / "bk.pt")
+    ck = torch.load(tmp_path / "bk.pt", weights_only=True)            # só tipos primitivos/tensores
+    assert set(ck) >= {"format", "spec_json", "arch_sha256", "state_dict", "state_sha256", "torchscript"}
+    m2, spec2 = load_backbone(tmp_path / "bk.pt")
+    assert spec2.arch_hash() == m.spec.arch_hash() == info["arch_sha256"]
+    assert state_sha256(m2.state_dict()) == info["state_sha256"]
+    with torch.no_grad():
+        assert torch.equal(m2(x), ref)
+    ts, sj = load_standalone(tmp_path / "bk.pt")
+    with torch.no_grad():
+        assert torch.allclose(ts(x), ref, rtol=1e-6, atol=1e-6)
+    assert sj["head"]["embed_dim"] >= 1280
+
+
+def test_standalone_without_repo(tmp_path):
+    """Subprocesso isolado (python -I, cwd vazio, sem PYTHONPATH): ga_search NÃO importável; infere pelo arquivo."""
+    m, x = _complex_model()
+    with torch.no_grad():
+        ref = m(x)
+    save_backbone(m, tmp_path / "bk.pt")
+    torch.save({"x": x, "ref": ref}, tmp_path / "io.pt")
+    code = r"""
+import io, json, sys, torch
+try:
+    import ga_search  # noqa
+    sys.exit("ga_search importável: teste não isolado")
+except ModuleNotFoundError:
+    pass
+ck = torch.load("bk.pt", map_location="cpu", weights_only=True)
+spec = json.loads(ck["spec_json"])
+ts = torch.jit.load(io.BytesIO(ck["torchscript"])).eval()
+d = torch.load("io.pt", weights_only=True)
+with torch.no_grad():
+    y = ts(d["x"])
+assert y.shape[1] == spec["head"]["embed_dim"] >= 1280
+err = ((y - d["ref"]).norm() / d["ref"].norm()).item()
+print("ok", err)
+assert err < 1e-6, err
+"""
+    env = {k: v for k, v in os.environ.items() if k not in ("PYTHONPATH", "PYTHONSTARTUP")}
+    env.update(CUDA_VISIBLE_DEVICES="", OMP_NUM_THREADS="2")
+    r = subprocess.run([sys.executable, "-I", "-c", code], cwd=tmp_path, env=env, capture_output=True, text=True)
+    assert r.returncode == 0 and r.stdout.startswith("ok"), r.stderr + r.stdout
+
+
+def test_tampered_checkpoint_rejected(tmp_path):
+    m = build_backbone(flat_spec(REF_FLAT["B0"], head=HeadSpec(pooling="meanstd")))
+    save_backbone(m, tmp_path / "bk.pt", torchscript=False)
+    ck = torch.load(tmp_path / "bk.pt", weights_only=True)
+    ck["state_dict"]["blocks.0.conv.weight"][0, 0, 0, 0] += 1.0
+    torch.save(ck, tmp_path / "bad.pt")
+    with pytest.raises(ValueError):
+        load_backbone(tmp_path / "bad.pt")
+
+
+def test_grown_child_checkpoint_has_no_parent_dependency(tmp_path):
+    p = build_backbone(flat_spec(REF_FLAT["B0"], head=HeadSpec(pooling="meanstd")))
+    child = widen(start(p), {0: 32, 3: 128}).child
+    x = x_batch(2, 64)
+    with torch.no_grad():
+        ref = child.eval()(x)
+    save_backbone(child, tmp_path / "c.pt")
+    del p
+    m2, _ = load_backbone(tmp_path / "c.pt")
+    with torch.no_grad():
+        assert torch.equal(m2(x), ref)
