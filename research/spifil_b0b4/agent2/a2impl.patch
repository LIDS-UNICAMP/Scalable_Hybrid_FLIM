+def test_registry_and_validate_init(data):
+    _, _, td = data
+    assert {"spifil3", "spifil3_rand"} <= set(base.available())
+    m = base.get_initializer("spifil3", steps=10)
+    assert isinstance(m, Spifil3Predictive) and m.label_policy == "label_free"
