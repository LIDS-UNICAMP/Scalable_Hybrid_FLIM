+def test_ruler_cfgs_follow_R1():
+    o = R._ruler_cfg("orig", {"cov_k": 64, "max_train": 4000, "wise_alphas": [0, 1]})
+    c = R._ruler_cfg("cov", {"cov_k": 64})
+    assert (o["readout"], o["scaler"], o["C"], o["kappa_weight"], o["solver"]) == ("head", "none", 100, 1.0, "libsvm")
+    assert (c["readout"], c["scaler"], c["C"]) == ("cov_head", "standard", 100)
+    assert o["wise_alphas"] == [0, 1] and o["max_train"] == 4000
