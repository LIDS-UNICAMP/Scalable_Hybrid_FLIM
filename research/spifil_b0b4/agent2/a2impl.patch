+
+def test_cli_validation():
+    a = R.parse_args(["--dataset", "remote_sensing", "--inits", "spifil,s0plus:knn_smooth=3,whiten=0",
+                      "--seeds", "1,2", "--ae", "joint"])
+    assert a.inits == ["spifil", "s0plus:knn_smooth=3,whiten=0"] and a.seeds == [1, 2]
+    with pytest.raises(SystemExit):
+        R.parse_args(["--dataset", "x", "--ae", "foo"])
+
+
+def test_genomes_exact_and_embed_dim():
+    for name, info in GENOMES.items():
+        g = get_genome(name, info["dataset"])["genome"]
+        assert len(g["layers"]) == 8 and int(g["embed_dim"]) >= 1280          # R11
+    g = get_genome("rs_b1", "remote_sensing")["genome"]
+    assert [L["channels"] for L in g["layers"][:2]] == [73, 287] and g["seed"] == 42
+    with pytest.raises(ValueError):
+        get_genome("rs_b1", "flowers")
+    s = get_genome("seed_small", "remote_sensing", n_classes=14)["genome"]
+    assert s["depth"] == 6 and all(L["conv"] == "conv" for L in s["layers"][:6]) and s["embed_dim"] >= 1280
+
+
+def test_applicability_spifil3():
+    pytest.importorskip("ga_search.abstract_init.spifil3")
