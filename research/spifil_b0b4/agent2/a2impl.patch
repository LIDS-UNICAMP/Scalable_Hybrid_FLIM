+    assert pr["diagnostics"]["stage1"]["steps_run"] == 0
+    assert tuple(wr["conv.weight"].shape) == (8, 6, 3, 3) and torch.isfinite(wr["conv.weight"]).all()
+    assert len(pr["diagnostics"]["latent_to_kernel"]["r2_per_kernel"]) == 8
+    assert not torch.equal(wt["conv.weight"], wr["conv.weight"])
