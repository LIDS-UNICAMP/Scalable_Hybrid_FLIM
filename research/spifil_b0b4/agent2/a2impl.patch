+def test_ridge_recovers_linear_map():
+    g = torch.Generator().manual_seed(0)
+    xx = torch.randn(3000, 12, generator=g)
+    a = torch.randn(12, 4, generator=g)
+    t = xx @ a
+    w, lam, _, r2_ho, r2_fit = s3.ridge_fit(xx[:2500], t[:2500], xx[2500:], t[2500:], [1e-6, 1e-2, 1.0])
+    assert lam == 1e-6 and float(r2_ho.min()) > 0.999
+    assert F.cosine_similarity(w.float().T, a.T, dim=1).min() > 0.999
+
