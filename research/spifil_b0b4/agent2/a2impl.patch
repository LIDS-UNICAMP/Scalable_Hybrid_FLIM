+def test_jsonl_append_and_summary(tmp_path, capsys):
+    p = tmp_path / "r.jsonl"
+    for s, k in ((42, 0.5), (43, 0.7)):
+        R._append_jsonl(p, {"run": f"a{s}", "status": "ok", "genome": "g", "init": "spifil", "ae": "joint",
+                            "fidelity": 45.0, "kappa_val_ORIG": k, "kappa_val_COV": k + 0.1})
+    R._append_jsonl(p, {"run": "b", "status": "failed", "genome": "g", "init": "random", "ae": "joint",
+                        "fidelity": 45.0})
+    R.summarize(p)
+    out = capsys.readouterr().out
+    assert "0.6000±0.1000" in out and "random" not in out
+    assert len(p.read_text().splitlines()) == 3 and all(json.loads(x) for x in p.read_text().splitlines())
+
