+def test_correspondence_identity_and_hflip_exact():
+    I = torch.tensor([[[1.0, 0, 0], [0, 1.0, 0]]])
+    Hf = torch.tensor([[[-1.0, 0, 0], [0, 1.0, 0]]])
+    H = W = 8
+    c = s2.correspondences(I, I, (H, W), margin_cells=0.5)
+    assert len(c) == H * W and torch.equal(c.pa, c.pb) and float(c.err.max()) < 1e-6
+    c = s2.correspondences(I, Hf, (H, W), margin_cells=0.5)
+    i, j = c.pa // W, c.pa % W
+    assert len(c) == H * W
+    assert torch.equal(c.ib, i) and torch.equal(c.jb, W - 1 - j)
+
+
+def _centroid(m):
+    """Centróide sub-célula (linha, coluna) de um mapa 2D não negativo."""
+    H, W = m.shape
+    yy, xx = torch.meshgrid(torch.arange(H).float(), torch.arange(W).float(), indexing="ij")
+    s = m.sum()
+    return float((m * yy).sum() / s), float((m * xx).sum() / s)
+
+
+@pytest.mark.parametrize("rot", [False, True])
+@pytest.mark.parametrize("pool", [1, 4])
+def test_correspondence_recovers_marked_position(rot, pool):
+    """Um ponto marcado (gaussiana) na imagem: a célula da vista a que o contém, mapeada por θ,
+    cai a ≤ 1 célula da posição do ponto na vista b (grade da imagem e grade 4× reduzida)."""
+    S, n = 64, 16
+    g = torch.Generator().manual_seed(0)
+    yy, xx = torch.meshgrid(torch.arange(S).float(), torch.arange(S).float(), indexing="ij")
+    x = torch.zeros(n, 1, S, S)
+    for i in range(n):
+        r, c = (24 + 16 * torch.rand(2, generator=g)).tolist()
+        x[i, 0] = torch.exp(-((yy - r) ** 2 + (xx - c) ** 2) / (2 * 1.5 ** 2))
+    pol = s2.AugPolicy(crop_scale=(0.5, 0.9), brightness=0, contrast=0, channel_jitter=0, rot90=rot)
+    views, thetas, _ = s2.make_views_with_theta(x, 2, pol, seed=1)
+    fa = F.avg_pool2d(views[0], pool) if pool > 1 else views[0]
+    fb = F.avg_pool2d(views[1], pool) if pool > 1 else views[1]
+    G = fa.shape[-1]
+    corr = s2.correspondences(thetas[0], thetas[1], (G, G))
+    errs = []
+    for i in range(n):
+        if fa[i].max() < 0.2 or fb[i].max() < 0.2:
+            continue
+        ra, ca = _centroid(fa[i, 0])
+        rb, cb = _centroid(fb[i, 0])
+        pa = int(round(ra)) * G + int(round(ca))
+        sel = (corr.img == i) & (corr.pa == pa)
+        if not bool(sel.any()):
+            continue
+        ib, jb = int(corr.ib[sel][0]), int(corr.jb[sel][0])
+        errs.append(max(abs(ib - rb), abs(jb - cb)))
+    assert len(errs) >= n // 2
+    assert max(errs) <= 1.0 + 1e-6, errs          # tolerância de 1 célula (desenho §5.2)
+    assert sum(errs) / len(errs) <= 0.75, errs
+
