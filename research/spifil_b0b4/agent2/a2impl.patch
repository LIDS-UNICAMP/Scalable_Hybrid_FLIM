+def test_theta_reproduces_the_view(data):
+    """Amostrar a imagem com o θ devolvido (sem fotometria) == a vista (inclui rot90)."""
+    x, _ = data
+    for rot in (False, True):
+        pol = s2.AugPolicy(brightness=0, contrast=0, channel_jitter=0, rot90=rot)
+        views, thetas, _ = s2.make_views_with_theta(x, 2, pol, seed=5)
+        for v, th in zip(views, thetas):
+            grid = F.affine_grid(th, v.shape, align_corners=False)
+            rs = F.grid_sample(x, grid, mode="bilinear", padding_mode="reflection",
+                               align_corners=False).clamp(0, 1)
+            assert torch.allclose(rs, v, atol=1e-5), rot
