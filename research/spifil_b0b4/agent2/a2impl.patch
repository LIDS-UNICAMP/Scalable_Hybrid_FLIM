+
+
+def test_parse_and_split_inits():
+    assert R._split_inits("spifil,random,s0plus:knn_smooth=5,whiten=false,spifil1") == \
+        ["spifil", "random", "s0plus:knn_smooth=5,whiten=false", "spifil1"]
+    assert R.parse_init("s0plus:knn_smooth=5,whiten=false") == ("s0plus", {"knn_smooth": 5, "whiten": False})
+    assert R.parse_init("spifil2:variant=s2_noinv") == ("spifil2", {"variant": "s2_noinv"})
+    assert R.init_tag("s0data:images_total=256") == "s0data-images_total256"
+    assert R.run_name("rs_b1", "spifil", "joint", 42) == "rs_b1__spifil__joint__s42"
+
+
+def test_plan_order_spifil_before_random_and_unique():
+    plan = R.build_plan(["rs_b1"], ["random", "s0plus", "spifil"], ["noae", "joint"], [42, 1042])
+    assert len(plan) == 12 and len({p["name"] for p in plan}) == 12
+    for i, p in enumerate(plan):
+        if p["init"] == "random":
+            src = R.run_name(p["genome"], "spifil", p["ae"], p["seed"])
+            assert any(q["name"] == src for q in plan[:i])
