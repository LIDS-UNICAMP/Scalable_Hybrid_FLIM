+                   "pooling": "moments", "projector": False, "protect": "freeze", "reg": "sigreg", "seed": 42,
+                   "spifil_images_per_class": 16, "ssl": "lejepa"}},
+    "flowers_b1": {
+        "dataset": "flowers",
