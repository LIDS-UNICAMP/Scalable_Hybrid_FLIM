+        assert torch.equal(a, b)
+    cfg = {"crop_scale": (0.5, 0.9), "vflip_p": 0.0, "channel_jitter": 0.1}
+    ref = st.make_views(x, 2, st.AugConfig(**cfg), generator=torch.Generator().manual_seed(seed))
+    got, _, _ = s2.make_views_with_theta(x, 2, cfg, generator=torch.Generator().manual_seed(seed))
