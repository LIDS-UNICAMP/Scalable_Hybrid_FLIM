+def test_kernel_fold_matches_zspace_response(data):
+    """conv(F)[p] = w_unit·(x_p − μ_X)/σ_X: a dobra do z-score no weight/bias é exata."""
+    x, _, td = data
+    prefix = _prefix()
+    w, b, _ = Spifil3Predictive().fit(prefix, td, _spec(), _ctx())
+    with torch.no_grad():
+        f = prefix(x[:2])
+    conv = F.conv2d(f, w["conv.weight"], b["conv.bias"], padding=1)          # (2, C, H, W)
+    patches = F.unfold(f, 3, padding=1)                                       # (2, D, HW)
+    lin = torch.einsum("cd,bdp->bcp", w["conv.weight"].flatten(1), patches) + b["conv.bias"][None, :, None]
+    assert torch.allclose(conv.flatten(2), lin, atol=1e-4)
+
