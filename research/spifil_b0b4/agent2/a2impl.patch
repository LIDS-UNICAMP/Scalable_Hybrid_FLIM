+# ---------------------------------------------------------------- prefixo intocado
+
+
+def test_prefix_untouched(data):
+    _, _, td = data
+    prefix = _prefix()
+    before = {k: v.clone() for k, v in prefix.state_dict().items()}
+    fp = base.prefix_fingerprint(prefix)
+    seen = []
+    prefix.register_forward_hook(lambda m, i, o: seen.append((m.training, any(p.requires_grad for p in m.parameters()))))
+    _, _, prov = Spifil3Predictive().fit(prefix, td, _spec(), _ctx())
+    after = prefix.state_dict()
+    assert all(torch.equal(before[k], after[k]) for k in before)
+    assert base.prefix_fingerprint(prefix) == fp == prov["prefix_state_sha256"]
+    assert all(p.grad is None for p in prefix.parameters())
+    assert seen and all(tr is False and rg is False for tr, rg in seen)  # eval + congelado durante o fit
+    assert prefix.training is True and all(p.requires_grad for p in prefix.parameters())  # estado restaurado
+
+
+# ---------------------------------------------------------------- preditor descartado
+
+
+def test_predictor_not_in_final_module(data):
+    _, _, td = data
+    method = Spifil3Predictive()
+    spec = _spec()
+    w, b, prov = method.fit(_prefix(), td, spec, _ctx())
+    assert set(w) == {"conv.weight"} and set(b) == {"conv.bias"}
+    blk = build_block(spec, w, b)
+    names = list(blk.state_dict()) + [n for n, _ in blk.named_modules()]
+    for bad in ("predictor", "context_encoder", "target_encoder", "reconstructor", "mask_token", "target_token"):
+        assert not any(bad in n for n in names), bad
+    gc.collect()
+    assert method.last_aux_refs and all(r() is None for r in method.last_aux_refs)  # temporários liberados
+    assert not any(isinstance(v, nn.Module) for v in vars(method).values())
+    assert prov["diagnostics"]["stage1"]["aux_params_discarded"] > 0
+    assert prov["diagnostics"]["stage1"]["steps_run"] == FAST["steps"]
