+        g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    b, _ = B.get_initializer("spifil0").init_block(g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    assert all(torch.equal(a.state_dict()[k], b.state_dict()[k]) for k in a.state_dict())   # tudo desligado == S0
+    c, _ = B.get_initializer("s0plus", whiten=False, select_diverse=0.0, knn_smooth=3).init_block(
+        g, 1, _prefix(), _td(samples[:6]), _ctx(g, 1))
+    assert not torch.equal(c.conv.weight, b.conv.weight)
