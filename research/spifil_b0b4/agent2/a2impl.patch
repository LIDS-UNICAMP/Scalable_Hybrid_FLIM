+# ─── label-free: invariância a permutação de rótulos (contrato I6, via um método label-free) ─────
+
+def test_label_free_dispatch_hides_labels():
+    """O despachante do runner entrega y = -1 a um método label-free (ele nunca vê rótulos)."""
+    from ga_search.abstract_init.run_ablation import _Dispatch
+
+    class LF(_Toy):
+        label_policy = "label_free"
+
+    class FakeEv:
+        svm_train_x = torch.randn(10, 3, 8, 8)
+        svm_train_y = torch.arange(10) % 2
+        split_hash = "h"
+        seed = 42
+        spifil_pool = {1: [], 2: []}
+        cfg = {"data": {"batch_size": 4, "image_size": 8}}
+        device = torch.device("cpu")
+    td = _Dispatch(FakeEv(), LF()).train_data([])
+    assert td.label_policy == "label_free" and td.mask_policy == "no_mask"
+    ys = torch.cat([y for _, y in td.loader_factory(0)])
+    assert (ys == -1).all()
+    xs1 = torch.cat([x for x, _ in td.loader_factory(0)])
+    FakeEv.svm_train_y = FakeEv.svm_train_y[torch.randperm(10)]       # rótulos permutados: mesmos x
+    xs2 = torch.cat([x for x, _ in _Dispatch(FakeEv(), LF()).train_data([]).loader_factory(0)])
+    assert torch.equal(xs1, xs2)
+    sup = _Dispatch(FakeEv(), _Toy()).train_data([])
+    assert sup.label_policy == "supervised"
+    assert sorted(torch.cat([y for _, y in sup.loader_factory(0)]).tolist()) == sorted(FakeEv.svm_train_y.tolist())
+
