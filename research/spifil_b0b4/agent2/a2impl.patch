+    assert prov["s0plus_record"]["zca_folded"] >= 1
+    assert not torch.equal(plus.conv.weight, base_blk.conv.weight)
+    assert torch.isfinite(plus.conv.weight).all()
+    assert any("zca_folded" in a for a in prov["abstract_init"]["approximations"])
+
+
+def test_s0plus_fold_is_exact_against_whitened_space():
+    """A dobra w <- W f reproduz <f, W x> no espaço original (mesma identidade usada por flim.spifil.grow)."""
+    torch.manual_seed(0)
+    x = torch.randn(500, 12, dtype=torch.float64)
+    s, u = torch.linalg.eigh(torch.cov(x.T))
+    zca = u @ torch.diag(1 / torch.sqrt(s + 1e-2 * s.mean())) @ u.T
+    f = torch.randn(5, 12, dtype=torch.float64)
+    assert torch.allclose((x @ zca) @ f.T, x @ (f @ zca).T, atol=1e-10)
+
