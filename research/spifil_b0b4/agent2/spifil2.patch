+# ─── dados sintéticos ────────────────────────────────────────────────────────
+def _synth(n=12, size=32, seed=0):
+    """3 classes: listras horizontais, verticais e bolhas; LAB-like em [0,1]."""
+    g = torch.Generator().manual_seed(seed)
+    yy, xx = torch.meshgrid(torch.arange(size).float(), torch.arange(size).float(), indexing="ij")
+    xs, ys = [], []
+    for i in range(n):
+        c = i % 3
+        ph = float(torch.rand(1, generator=g)) * 6.28
+        if c == 0:
+            base = 0.5 + 0.4 * torch.sin(yy / 2.0 + ph)
+        elif c == 1:
+            base = 0.5 + 0.4 * torch.sin(xx / 2.0 + ph)
+        else:
+            cy, cx = (torch.rand(2, generator=g) * size).tolist()
+            base = 0.2 + 0.7 * torch.exp(-((yy - cy) ** 2 + (xx - cx) ** 2) / 30.0)
+        img = torch.stack([base, 0.5 + 0.2 * (base - 0.5), 0.5 - 0.1 * (base - 0.5)])
+        img = img + 0.03 * torch.randn(3, size, size, generator=g)
+        xs.append(img.clamp(0, 1))
+        ys.append(c)
+    return torch.stack(xs), torch.tensor(ys)
+
+
+def _train_data(x, y, split="train", policy="label_free", bs=4):
+    def factory(seed):
+        perm = torch.randperm(x.shape[0], generator=torch.Generator().manual_seed(seed))
+        for s in range(0, x.shape[0], bs):
+            idx = perm[s:s + bs]
+            yield x[idx], y[idx]
+    return s2.TrainData(donors=[], loader_factory=factory, split_key=split,
+                        split_fingerprint="sha-synth", n_classes=int(y.max()) + 1,
+                        image_size=x.shape[-1], label_policy=policy, mask_policy="no_mask")
+
+
+def _ctx(seed=7, config=None):
+    return s2.InitContext(seed=seed, device=torch.device("cpu"), layer_idx=0, prefix_id="p0",
+                          budget=s2.InitBudget(max_images=12, max_patches=4000),
+                          config={"spifil2": {**FAST, **(config or {})}})
+
