+def test_invariance_terms_drive_the_choice():
+    """Com candidatos k-means reais, S2 escolhe filtros mais estáveis que a média do banco e que
+    o controle sem invariância (s2_noinv) — o critério é o que muda a escolha."""
+    x, y = _blobs()
+    spec = to_ops_spec({"conv": "conv", "kernel": 3, "channels": 2}, 1)
+    ctx = s2.InitContext(seed=0, device=torch.device("cpu"), layer_idx=0, prefix_id="p",
+                         budget=s2.InitBudget(max_images=24, max_patches=6000),
+                         config={"spifil2": {**FAST, "aug_policy": FLIP_JITTER, "cand_mult": 6}})
+    _, _, p_inv = s2.Spifil2Invariant().fit(None, _train_data(x, y), spec, ctx)
+    _, _, p_ctl = s2.Spifil2Invariant(variant="s2_noinv").fit(None, _train_data(x, y), spec, ctx)
+    bi, bc = p_inv["banks"][0], p_ctl["banks"][0]
+    assert bi["selected_mean"]["stab"] > bi["candidates_mean"]["stab"]
+    assert bi["selected_mean"]["stab"] > bc["selected_mean"]["stab"]
+    assert p_ctl["variant"] == "s2_noinv" and p_ctl["method_config"]["lam_stab"] == 0.0
+
