+def test_correspondence_identity_and_hflip_exact():
+    I = torch.tensor([[[1.0, 0, 0], [0, 1.0, 0]]])
+    Hf = torch.tensor([[[-1.0, 0, 0], [0, 1.0, 0]]])
+    H = W = 8
+    c = s2.correspondences(I, I, (H, W), margin_cells=0.5)
+    assert len(c) == H * W and torch.equal(c.pa, c.pb) and float(c.err.max()) < 1e-6
+    c = s2.correspondences(I, Hf, (H, W), margin_cells=0.5)
+    i, j = c.pa // W, c.pa % W
+    assert len(c) == H * W
+    assert torch.equal(c.ib, i) and torch.equal(c.jb, W - 1 - j)
