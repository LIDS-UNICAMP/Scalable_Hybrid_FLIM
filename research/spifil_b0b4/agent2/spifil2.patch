+def test_greedy_nms_rejects_duplicates():
+    Cw = torch.tensor([[1.0, 0, 0], [1.0, 0.01, 0], [0, 1.0, 0], [0, 0, 1.0]])
+    score = torch.tensor([3.0, 2.9, 1.0, 0.5], dtype=torch.float64)
+    stab = torch.ones(4, dtype=torch.float64)
+    sel, relax = s2._greedy_select(score, Cw, 3, stab, s2.DEFAULT_CONFIG)
+    assert sel == [0, 2, 3] and relax == {"floor_relaxed": 0, "nms_relaxed": 0}
+    # piso de estabilidade: candidato instável só entra se faltar
+    stab = torch.tensor([0.9, 0.9, 0.0, 0.9], dtype=torch.float64)
+    sel, relax = s2._greedy_select(score, Cw, 3, stab, s2.DEFAULT_CONFIG)
+    assert sel[:2] == [0, 3] and relax["floor_relaxed"] == 1
+
