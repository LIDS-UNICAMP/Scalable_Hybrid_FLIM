+@pytest.mark.parametrize("layer,cin", SPECS, ids=lambda v: str(v))
+def test_shapes_match_spifil_ops_block(data, layer, cin):
+    x, y = data
+    spec = to_ops_spec({"activation": "relu", "pool": "none", "norm": "none", **layer}, cin)
+    w, b, prov = s2.Spifil2Invariant().fit(None, _train_data(x, y), spec, _ctx())
+    eff = prov["effective_spec"]
+    ref = SpifilOpsBlock(eff, eff["in_channels"]).state_dict()
+    conv_keys = {k for k in ref if k.startswith(("conv.", "skip."))}
+    assert set(w) | set(b) == conv_keys
+    for k, v in {**w, **b}.items():
+        assert tuple(v.shape) == tuple(ref[k].shape), k
+        assert v.dtype == torch.float32 and torch.isfinite(v).all(), k
+    blk = SpifilOpsBlock(eff, eff["in_channels"])
+    sd = blk.state_dict()
+    sd.update({**w, **b})
+    blk.load_state_dict(sd, strict=True)
+    out = blk(x[:2])
+    assert out.shape == (2, eff["channels"], x.shape[2], x.shape[3])
+    json.dumps(prov)                                    # proveniência serializável
+    assert prov["labels_used"] is False and prov["mask_used"] is False
+    assert prov["method"] == "spifil2" and prov["data"]["split_key"] == "train"
