+"""Guardas antes de LAPACK (eigh/eigvalsh) nos inicializadores abstratos.
+
+Motivo (athena, torch 2.2 + MKL): "Intel MKL ERROR: Parameter 4/5 DLASCL" no fit do S1/S2 = matriz
+de entrada com NaN/Inf ou identicamente zero chegando ao eigh. Regras:
+* NaN/Inf na matriz -> ``InfeasibleCandidate`` (determinístico, nunca um eigh silencioso).
+* matriz zero (ex.: canais mortos) -> autovalores 0 e autovetores = identidade, SEM chamar o LAPACK.
+* senão: simetriza; jitter relativo opcional (``jitter_rel``, padrão 0 = resultado bit a bit igual ao
+  eigh direto numa matriz já simétrica).
+"""
+from __future__ import annotations
+
+import torch
+
+from ga_search.abstract_init.base import InfeasibleCandidate
+
+
+def _prep(cov: torch.Tensor, where: str, jitter_rel: float):
+    if not bool(torch.isfinite(cov).all()):
+        raise InfeasibleCandidate(f"{where}: matriz com NaN/Inf antes do eigh",
+                                  details={"where": where, "n_nonfinite": int((~torch.isfinite(cov)).sum())})
+    cov = 0.5 * (cov + cov.transpose(-1, -2))
+    scale = float(cov.diagonal(dim1=-2, dim2=-1).abs().mean()) if cov.numel() else 0.0
+    if not scale > 0:
+        return cov, True
+    if jitter_rel:
+        cov = cov + (jitter_rel * scale) * torch.eye(cov.shape[-1], dtype=cov.dtype, device=cov.device)
+    return cov, False
+
+
+def safe_eigh(cov: torch.Tensor, where: str = "eigh", jitter_rel: float = 0.0):
+    cov, zero = _prep(cov, where, jitter_rel)
+    if zero:
+        d = cov.shape[-1]
+        return (torch.zeros(d, dtype=cov.dtype, device=cov.device),
+                torch.eye(d, dtype=cov.dtype, device=cov.device))
+    return torch.linalg.eigh(cov)
+
+
+def safe_eigvalsh(cov: torch.Tensor, where: str = "eigvalsh", jitter_rel: float = 0.0):
+    cov, zero = _prep(cov, where, jitter_rel)
+    if zero:
+        return torch.zeros(cov.shape[-1], dtype=cov.dtype, device=cov.device)
+    return torch.linalg.eigvalsh(cov)
+
+
+def check_finite_rows(X: torch.Tensor, where: str) -> None:
+    """Antes de k-means/covariância: NaN/Inf nos patches -> InfeasibleCandidate."""
+    if not bool(torch.isfinite(X).all()):
+        raise InfeasibleCandidate(f"{where}: patches com NaN/Inf", details={"where": where})
