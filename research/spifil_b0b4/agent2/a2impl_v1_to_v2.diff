diff --git a/tests/abstract_init/test_safe_linalg.py b/tests/abstract_init/test_safe_linalg.py
new file mode 100644
index 0000000..952fd4d
--- /dev/null
+++ b/tests/abstract_init/test_safe_linalg.py
@@ -0,0 +1,32 @@
+"""Guardas antes do LAPACK (MKL DLASCL no athena): NaN/Inf -> InfeasibleCandidate; zero -> sem LAPACK."""
+import pytest
+import torch
+
+from ga_search.abstract_init._safe_linalg import check_finite_rows, safe_eigh, safe_eigvalsh
+from ga_search.abstract_init.base import InfeasibleCandidate
+
+
+def test_equal_to_eigh_on_symmetric():
+    torch.manual_seed(0)
+    a = torch.randn(30, 6, dtype=torch.float64)
+    c = a.T @ a
+    e1, v1 = torch.linalg.eigh(c)
+    e2, v2 = safe_eigh(c)
+    assert torch.equal(e1, e2) and torch.equal(v1, v2)
+    assert torch.equal(safe_eigvalsh(c), torch.linalg.eigvalsh(c))
+
+
+@pytest.mark.parametrize("bad", [float("nan"), float("inf")])
+def test_nonfinite_is_infeasible(bad):
+    c = torch.eye(4)
+    c[1, 2] = bad
+    with pytest.raises(InfeasibleCandidate, match="NaN/Inf"):
+        safe_eigh(c, "t")
+    with pytest.raises(InfeasibleCandidate):
+        check_finite_rows(c, "t")
+
+
+def test_zero_matrix_skips_lapack():
+    e, v = safe_eigh(torch.zeros(5, 5))
+    assert torch.equal(e, torch.zeros(5)) and torch.equal(v, torch.eye(5))
+    assert torch.equal(safe_eigvalsh(torch.zeros(3, 3)), torch.zeros(3))
