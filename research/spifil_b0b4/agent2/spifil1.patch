+def test_unfolded_patches_match_unfold():
+    f = torch.randn(2, 4, 7, 7)
+    r, c = torch.meshgrid(torch.arange(7), torch.arange(7), indexing="ij")
+    pr, pc = r.reshape(1, -1).expand(2, -1), c.reshape(1, -1).expand(2, -1)
+    mine = dense_patches_at(f, pr, pc, 3)
+    ref = F.unfold(f, 3, padding=1).transpose(1, 2).reshape(-1, 4 * 9)
+    assert torch.equal(mine, ref)
