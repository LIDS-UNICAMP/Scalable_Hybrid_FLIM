+# UNIDADE (auditoria CHECK C5): todo "flops" deste modulo = 2*MAC (+ ~5/elem de softmax e
+# normas).  O campo ``flops`` da busca (result.json / profile()) e MAC de Conv2d/Linear:
+# compare sempre via ``encoder_flops_2mac`` (= 2 * MAC).
+FLOPS_UNIT = "2*MAC"
+ATTN_FLOPS_MAX_FRAC = 0.25     # criterio: FLOPs(operador) <= 25% de 2*MAC(encoder+cabeca)
+ALIGN_DEGENERATE_K = 5         # align_k <= 5: E3/E4 degenerado (relatar a parte)
+
+
+def encoder_macs(encoder: nn.Module, head: nn.Module, image_size: int = 224) -> int:
+    """MACs de Conv2d/Linear de ``head(encoder(x))`` por imagem -- MESMA metodologia do
+    ``run_search.profile`` (kernel terms, ``out.numel()*kh*kw*cin/groups``)."""
+    macs = 0
+
+    def count(mod, inp, out):
+        nonlocal macs
+        if isinstance(mod, nn.Conv2d):
+            macs += out.numel() * mod.kernel_size[0] * mod.kernel_size[1] * mod.in_channels // mod.groups
+        elif isinstance(mod, nn.Linear):
+            macs += out.numel() * mod.in_features
+    mods = [m for m in list(encoder.modules()) + list(head.modules())
+            if isinstance(m, (nn.Conv2d, nn.Linear))]
+    hs = [m.register_forward_hook(count) for m in mods]
+    dev = next(iter(encoder.parameters())).device
+    try:
+        with torch.no_grad(), eval_mode(encoder), eval_mode(head):
+            head(encoder(torch.zeros(1, 3, image_size, image_size, device=dev)))
+    finally:
+        for h in hs:
+            h.remove()
+    return int(macs)
+
+
+def cost_ratio(attn_flops: float, enc_macs: int) -> dict:
+    """Operador (2*MAC) contra encoder+cabeca na MESMA unidade (2*MAC)."""
+    enc = 2.0 * float(enc_macs)
+    r = float(attn_flops) / enc if enc > 0 else float("inf")
+    return {"encoder_flops_2mac": enc, "attn_over_encoder": r,
+            "attn_within_budget": bool(r <= ATTN_FLOPS_MAX_FRAC)}
 
 
