+def fit_sample_indices(n: int, n_img: int, seed: int = 0) -> list[int]:
+    """Sorteio UNIFORME semeado, sem rotulo, de ``min(n_img, n)`` indices em ``range(n)``
+    (ordem do sorteio; deterministico; independe da ordem por classe do treino)."""
+    g = torch.Generator(device="cpu").manual_seed(int(seed) + 7919)
+    return torch.randperm(int(n), generator=g)[: min(int(n_img), int(n))].tolist()
