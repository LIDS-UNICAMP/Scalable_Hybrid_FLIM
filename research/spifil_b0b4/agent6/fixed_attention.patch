+        assert torch.equal(emb(x), ref)
+        emb.attn.force_compute = True                   # mesmo calculando o operador
+        assert torch.equal(emb(x), ref)
+    assert any("identidade exata" in n for n in notes)
+
+
+def test_alpha_zero_operator_level_bitwise():
+    x = torch.randn(2, 9, 8, 8)
+    for cls in (FA.FixedSelfAttention, FA.FixedCovarianceAttention):
+        op = cls(FA.AttentionSpec(attention_residual_alpha=0.0, attention_tokens=16))
+        op.force_compute = True
+        assert torch.equal(op(x), x)
+
+
+def test_uniform_weights_reproduce_head_pooling():
+    for pooling in POOLINGS:
+        head = EmbeddingHead(8, 1280, pooling).eval()
+        zz = torch.randn(3, head.width, 5, 6)
