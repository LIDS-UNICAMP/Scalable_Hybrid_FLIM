+def test_tta_views_and_cost():
+    x = torch.randn(1, 3, 10, 10)
+    assert len(FA.tta_views("tta4")) == 4 and len(FA.tta_views("tta8")) == 8
+    ours = torch.stack([t(x) for t in FA.tta_views("tta8")])
+    ref = torch.stack([t(x) for t in tta_transforms(8)])
+    assert torch.equal(ours, ref)                     # = pooling_head (gem_tta do repo)
+    assert FA.tta_cost("none") == 1 and FA.tta_cost("tta4") == 4 and FA.tta_cost("tta8") == 8
+    assert FA.tta_cost("multiscale") == pytest.approx(0.75 ** 2 + 1 + 1.25 ** 2)
+    sizes = [t(x).shape[-1] for t in FA.tta_views("multiscale")]
+    assert sizes == [8, 10, 12]
+    e = [torch.randn(2, 5) for _ in range(3)]
+    assert torch.allclose(FA.aggregate_views(e, "mean"), sum(e) / 3)
+    assert torch.allclose(FA.aggregate_views(e, "l2_mean").norm(dim=1) <= 1 + 1e-6,
+                          torch.ones(2, dtype=torch.bool))
