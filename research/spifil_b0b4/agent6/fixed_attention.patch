+def test_exclude_self_masks_diagonal():
+    v = torch.eye(5)[None]                           # tokens ortogonais
+    out = FA.attend(v, v, v, similarity="cosine", tau=0.01, aggregation="weighted_mean",
+                    self_index=torch.arange(5))
+    assert torch.all(out[0].diagonal() < 1e-6)
+    out2 = FA.attend(v, v, v, similarity="cosine", tau=0.01, aggregation="weighted_mean")
+    assert torch.all(out2[0].diagonal() > 0.9)
