+def test_self_attention_full_tokens_is_q_eq_k_eq_v():
+    x = torch.randn(1, 4, 3, 3)
+    spec = FA.AttentionSpec(attention_tokens=16, attention_residual_alpha=1.0,
+                            attention_temperature=0.5)
+    y = FA.FixedSelfAttention(spec)(x)
+    t = x.flatten(2).transpose(1, 2)
+    tn = t / t.norm(dim=-1, keepdim=True)
+    ref = torch.softmax(tn @ tn.transpose(1, 2) / 0.5, -1) @ t
+    assert torch.allclose(y, ref.transpose(1, 2).reshape(1, 4, 3, 3), atol=1e-6)
