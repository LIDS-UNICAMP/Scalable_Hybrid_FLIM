+def test_alignment_svd_recovers_shared_subspace():
+    """CCA: duas camadas = rotacoes diferentes do mesmo sinal -> keys e queries alinhadas."""
+    g = torch.Generator().manual_seed(0)
+    s = torch.randn(500, 4, generator=g, dtype=torch.float64)
+    xq = s @ torch.linalg.qr(torch.randn(4, 4, generator=g, dtype=torch.float64))[0]
+    xk = s @ torch.randn(4, 6, generator=g, dtype=torch.float64)
+    for mode in ("svd", "pca"):
+        a = FA.Alignment(mode, 4, 6, 4).fit(xq, xk)
+        zq, zk = a.q(xq.float()), a.kv(xk.float())
+        cos = torch.nn.functional.cosine_similarity(zq, zk, dim=1)
+        assert cos.mean() > 0.99, mode
