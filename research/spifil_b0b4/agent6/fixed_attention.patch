+# ─── PCA / SVD: deterministico, ajustado so no treino ────────────────────────
+
+@pytest.mark.parametrize("align", ["pca", "svd"])
+@pytest.mark.parametrize("typ", list(FA.CROSS_OPS))
+def test_alignment_deterministic_and_train_only(align, typ):
