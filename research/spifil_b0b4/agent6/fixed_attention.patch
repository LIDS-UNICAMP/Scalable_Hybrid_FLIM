+    # avaliar val/teste NAO reajusta nada
+    with torch.no_grad():
+        e1.embed(xva, bs=2), e1.embed(xva, bs=2, tta="tta8")
+    for k, v in e1.attn.state_dict().items():
+        assert torch.equal(v, b1[k]), k
+    # outro conjunto de treino -> outras estatisticas (prova que vem do treino passado)
+    e3, *_ = _build(typ, attention_alignment=align, enc=copy.deepcopy(enc), fit=False)
+    e3.fit(_x(6, seed=11), bs=3, n_img=6, n_px=16, seed=0)
+    assert any(not torch.equal(v, b1[k]) for k, v in e3.attn.state_dict().items())
+    # sem fit -> erro explicito (nunca ajusta sozinho em val/teste)
+    e4, *_ = _build(typ, attention_alignment=align, enc=copy.deepcopy(enc), fit=False)
+    with pytest.raises(RuntimeError):
+        e4(xva)
