+"""Testes de ga_search/modehb/fixed_attention.py (atencao SEM parametros treinaveis)."""
+
+import copy
+import itertools
+
+import pytest
+import torch
+import torch.nn as nn
+
+from ga_search.modehb import fixed_attention as FA
+from ga_search.modehb.pooling_head import POOLINGS, EmbeddingHead, tta_transforms
+
+TYPES = [t for t in FA.ATTENTION_TYPES if t != "none"]
+CHANS = (8, 12, 16)
+
+
+def _encoder(chans=CHANS, bn=True, dead=0):
+    """3 blocos conv -> mapas 16x16, 8x8, 4x4 (entrada 32x32); ``dead`` canais mortos no fim."""
+    torch.manual_seed(0)
+    blocks, cin = [], 3
+    for i, c in enumerate(chans):
+        layers = [nn.Conv2d(cin, c, 3, padding=1)]
+        if bn:
+            layers.append(nn.BatchNorm2d(c))
+        layers += [nn.ReLU(), nn.MaxPool2d(2)]
+        blocks.append(nn.Sequential(*layers))
+        cin = c
+    enc = nn.Sequential(*blocks)
+    if dead:
+        with torch.no_grad():
+            last = enc[-1][0]
+            last.weight[-dead:] = 0
+            last.bias[-dead:] = -1.0     # ReLU -> canal identicamente 0
+    return enc.eval()
+
+
+def _head(pooling="gap", in_ch=CHANS[-1], dim=1280):
+    torch.manual_seed(1)
+    return EmbeddingHead(in_ch, dim, pooling).eval()
+
+
+def _x(n=4, seed=2, size=32):
+    g = torch.Generator().manual_seed(seed)
+    return torch.randn(n, 3, size, size, generator=g)
+
+
+def _genes(typ, **kw):
+    g = {"attention_type": typ, "attention_tokens": 16, "attention_residual_alpha": 0.5,
+         "attention_temperature": 0.25, "align_k": 8}
+    if typ in FA.CROSS_OPS:
+        g["attention_alignment"] = "svd"
+    g.update(kw)
+    return g
+
+
+def _build(typ, pooling="gap", enc=None, fit=True, **kw):
+    enc = enc or _encoder()
+    head = _head(pooling)
+    emb, info, notes = FA.build_embedder(enc, head, _genes(typ, **kw), _x(1))
+    if fit:
+        emb.fit(_x(6, seed=9), bs=3, n_img=6, n_px=16)
+    return emb, enc, head, info, notes
+
+
+# ─── zero parametros treinaveis ──────────────────────────────────────────────
+
+@pytest.mark.parametrize("typ,align", [(t, a) for t in TYPES for a in
+                                       (FA.ALIGNMENTS if t in FA.CROSS_OPS else ("none",))])
+def test_zero_trainable_parameters(typ, align):
+    kw = {"attention_alignment": align} if typ in FA.CROSS_OPS else {}
+    if typ in FA.CROSS_OPS and align in ("none", "shared_channels"):
+        enc = _encoder(chans=(8, 12, 12))     # canais iguais nas 2 ultimas -> sem reparo
+        head = EmbeddingHead(12, 1280, "gap").eval()
+        emb, _, notes = FA.build_embedder(enc, head, _genes(typ, **kw), _x(1))
+        emb.fit(_x(6, seed=9), bs=3, n_img=6, n_px=16)
+    else:
+        emb, *_ = _build(typ, **kw)
+    emb(_x(2))
+    m = emb.attn
+    assert m is not None
+    assert sum(p.numel() for p in m.parameters()) == 0
+    assert sum(p.numel() for p in emb.parameters()) == 0      # encoder/cabeca nao sao submodulos
+    assert list(m.parameters()) == []
+    assert not any(b.requires_grad for b in m.buffers())
+    assert not any(isinstance(x, nn.Linear) for x in m.modules())
+    assert m.n_trainable_params == 0
+    # operador com estatistica ajustada no treino e identificado
+    expected_fitted = typ in FA.CROSS_OPS and emb.spec.attention_alignment != "none"
+    assert emb.fitted_statistics == expected_fitted
+
+
+def test_cost_reports_zero_params_and_positive_flops():
+    for typ in TYPES:
+        emb, enc, head, info, _ = _build(typ)
+        c = info["cost"]
+        assert c["trainable_params"] == 0 and c["flops"] > 0 and c["peak_bytes"] > 0
+    _, _, _, info, _ = _build("fixed_self", attention_residual_alpha=0.0)
+    assert info["cost"]["flops"] == 0
+
+
+# ─── shapes ───────────────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("typ,pooling", list(itertools.product(TYPES, POOLINGS)))
+def test_embedding_shape_matches_head(typ, pooling):
+    emb, enc, head, _, _ = _build(typ, pooling)
+    y = emb.embed(_x(5), bs=2)
+    assert y.shape == (5, head.out_dim) and head.out_dim >= 1280
+    assert torch.isfinite(y).all()
+
+
+@pytest.mark.parametrize("tokens,hw", [(16, (16, 16)), (49, (14, 14)), (196, (14, 14)),
+                                       (196, (7, 9)), (16, (3, 3))])
+def test_map_operators_preserve_shape(tokens, hw):
+    x = torch.randn(2, 6, *hw)
+    for cls in (FA.FixedSelfAttention, FA.FixedCovarianceAttention):
+        spec = FA.AttentionSpec(attention_type="fixed_self", attention_tokens=tokens)
+        assert cls(spec)(x).shape == x.shape
+    t, (gh, gw) = FA.map_tokens(x, tokens)
+    g = FA.grid_side(tokens)
+    assert (gh, gw) == (min(g, hw[0]), min(g, hw[1])) and t.shape == (2, gh * gw, 6)
+
+
+def test_cross_preserves_query_shape_and_mass_sums_to_one():
+    emb, enc, *_ = _build("fixed_multiscale")
+    with torch.no_grad():
+        outs = emb._block_outputs(_x(2), 2)
+        y = emb.attn(outs[2], [outs[i] for i in emb.spec.attention_source_layers])
+    assert y.shape == outs[2].shape
+    assert torch.isclose(emb.attn.last_scale_mass.sum(), torch.tensor(1.0), atol=1e-5)
+
+
+# ─── estabilidade numerica ───────────────────────────────────────────────────
+
+@pytest.mark.parametrize("typ,norm,sim", list(itertools.product(
+    TYPES, FA.NORMALIZATIONS, FA.SIMILARITIES)))
+def test_no_nan_with_dead_channels(typ, norm, sim):
+    enc = _encoder(dead=8)                              # metade dos canais finais = 0
+    emb, *_ = _build(typ, "moments", enc=enc, attention_normalization=norm,
+                     attention_similarity=sim, attention_temperature=0.03)
+    y = emb.embed(_x(3), bs=3)
+    assert torch.isfinite(y).all()
+
+
+@pytest.mark.parametrize("cls", [FA.FixedSelfAttention, FA.FixedCovarianceAttention])
+def test_all_zero_and_constant_maps_are_finite(cls):
+    for x in (torch.zeros(2, 5, 6, 6), torch.full((2, 5, 6, 6), 3.0)):
+        for norm in FA.NORMALIZATIONS:
+            spec = FA.AttentionSpec(attention_tokens=16, attention_normalization=norm,
+                                    attention_exclude_self=True, attention_temperature=0.03)
+            assert torch.isfinite(cls(spec)(x)).all()
+    pool = FA.FixedAttentionPooling(FA.AttentionSpec(attention_aggregation="gem"))
+    w = pool.weights(torch.zeros(2, 5, 6, 6))
+    assert torch.isfinite(w).all() and torch.allclose(w.sum(1), torch.ones(2))
+
+
+def test_low_precision_inputs_are_finite():
+    x = torch.randn(2, 8, 7, 7) * 50
+    for dt in (torch.bfloat16, torch.float16):
+        for cls in (FA.FixedSelfAttention, FA.FixedCovarianceAttention):
+            y = cls(FA.AttentionSpec(attention_tokens=49, attention_temperature=0.03))(x.to(dt))
+            assert y.dtype == dt and torch.isfinite(y.float()).all()
+
+
+def test_alignment_with_dead_and_collinear_channels_is_finite():
+    g = torch.Generator().manual_seed(0)
+    base = torch.randn(200, 3, generator=g, dtype=torch.float64)
+    xq = torch.cat([base, base[:, :1] * 2, torch.zeros(200, 2, dtype=torch.float64)], 1)  # colinear + mortos
+    xk = torch.cat([base @ torch.randn(3, 4, generator=g, dtype=torch.float64),
+                    torch.zeros(200, 3, dtype=torch.float64)], 1)
+    for mode in ("pca", "svd"):
+        a = FA.Alignment(mode, 6, 7, 4).fit(xq, xk)
+        for b in a.buffers():
+            assert torch.isfinite(b).all()
+
+
+# ─── alpha = 0 => identidade exata ───────────────────────────────────────────
+
+@pytest.mark.parametrize("typ", TYPES)
+@pytest.mark.parametrize("pooling", POOLINGS)
+def test_alpha_zero_is_exact_identity_end_to_end(typ, pooling):
+    emb, enc, head, _, notes = _build(typ, pooling, attention_residual_alpha=0.0)
+    x = _x(3)
+    with torch.no_grad():
