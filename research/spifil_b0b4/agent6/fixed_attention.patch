+        assert torch.allclose(FA.weighted_head_pool(head, zz, w), head.pool(zz), atol=1e-4, rtol=1e-4)
+
+
+# ─── gradiente atravessa ate as ativacoes ────────────────────────────────────
+
+@pytest.mark.parametrize("typ", TYPES)
+def test_gradient_reaches_activations(typ):
+    emb, enc, head, _, _ = _build(typ)
+    enc.train(), head.train()
+    x = _x(3).requires_grad_(True)
+    emb(x).pow(2).sum().backward()
+    assert x.grad is not None and torch.isfinite(x.grad).all() and x.grad.abs().sum() > 0
+    assert sum(p.numel() for p in emb.attn.parameters()) == 0
+
+
+@pytest.mark.parametrize("cls,agg", list(itertools.product(
+    [FA.FixedSelfAttention, FA.FixedCovarianceAttention], ["weighted_mean", "gem"])))
+def test_operator_gradient_includes_attention_path(cls, agg):
+    """alpha=1: o gradiente passa SO pelo operador (softmax e values)."""
+    x = (torch.randn(2, 6, 7, 7).abs() + 0.1).requires_grad_(True)
+    y = cls(FA.AttentionSpec(attention_residual_alpha=1.0, attention_tokens=49,
+                             attention_aggregation=agg))(x)
+    y.pow(2).sum().backward()
+    assert torch.isfinite(x.grad).all() and x.grad.abs().sum() > 0
+
+
+def test_pooling_gradient():
+    head = _head("moments", in_ch=6)
+    z = torch.randn(2, head.width, 7, 7)
+    src = torch.randn(2, 6, 7, 7, requires_grad=True)
+    op = FA.FixedAttentionPooling(FA.AttentionSpec(attention_residual_alpha=1.0))
+    op(head, z, src).sum().backward()
+    assert torch.isfinite(src.grad).all() and src.grad.abs().sum() > 0
