ell><mxCell id="43" value="&lt;b&gt;Procedimento: híbrido de outubro&lt;/b&gt;&lt;br&gt;(SPiFiL + autoencoder)&lt;br&gt;1) SPiFiL inicializa cada camada&lt;br&gt;2) Autoencoder camada a camada&lt;br&gt;(backprop); camada congelada&lt;br&gt;em seguida&lt;br&gt;3) Sem SSL global&lt;br&gt;4) Leitura GeM + TTA + whitening&lt;br&gt;→ SVM linear C=100" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#b9e0a5;strokeColor=#5c9e42;align=left;spacingLeft=6;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="512" width="320" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>