 width="300" height="34" as="geometry"/></mxCell><mxCell id="79" value="Sem peso (entrada, concat, pooling)" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="216" width="300" height="34" as="geometry"/></mxCell><mxCell id="80" value="Saída / SVM" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#b9e0a5;strokeColor=#5c9e42;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="258" width="300" height="34" as="geometry"/></mxCell><mxCell id="81" value="Conv inicializada pelo SPiFiL" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#fff2cc;strokeColor=#2e7d32;fontSize=13;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1170" y="316" width="300" height="34" as="geometry"/></mxCell><mxCell id="82" value="Conv aleatória (PyTorch)" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#fff2cc;strokeColor=#c62828;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1170" y="358" width="300" height="34" as="geometry"/></mxCell><mxCell id="83" value="Conv parcial (canais novos sem SPiFiL)" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#fff2cc;strokeColor=#ef6c00;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1170" y="400" width="300" height="34" as="geometry"/></mxCell><mxCell id="84" value="Conv iniciada em zero (morfismo)" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#fff2cc;strokeColor=#6a1b9a;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1170" y="442" width="300" height="34" as="geometry"/></mxCell><mxCell id="85" value="&lt;b&gt;Procedimento: AE + LeJEPA&lt;/b&gt;&lt;br&gt;1) SPiFiL inicializa cada bloco (16 img/classe)&lt;br&gt;2) Autoencoder local por bloco (alvo: imagem mascarada); bloco congelado em seguida&lt;br&gt;3) SSL global no modelo inteiro: LeJEPA + SIGReg (5 épocas; filtros SPiFiL com congelados)&lt;br&gt;4) Leitura 2ª ordem + TTA → SVM linear C=100" style="rounded=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fillColor=#b9e0a5;strokeColor=#5c9e42;align=left;spacingLeft=6;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="512" width="320" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>